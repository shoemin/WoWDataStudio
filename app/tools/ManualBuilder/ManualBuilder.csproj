<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time tool: renders docs\manual\*.md to HTML for the installer and the app's Help / F1.
       Not part of WoWDataStudio.sln and not shipped; run by build_installer.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Markdig: BSD-2-Clause, build-time only (the generated HTML contains no Markdig code) -->
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

</Project>
