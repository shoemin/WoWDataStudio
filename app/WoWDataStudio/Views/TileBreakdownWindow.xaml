<Window x:Class="WoWDataStudio.Views.TileBreakdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WoWDataStudio.Controls"
        xmlns:v="clr-namespace:WoWDataStudio.Views"
        xmlns:vm="clr-namespace:WoWDataStudio.ViewModels"
        xmlns:h="clr-namespace:WoWDataStudio.Helpers"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="maps-and-terrain"
        Title="{Binding Title}" Width="1440" Height="900" MinWidth="900" MinHeight="560"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner">
    <!-- "Break down this tile" (docs\manual\maps-and-terrain.md#break-down-a-tile). DataContext = TileBreakdownViewModel. -->
    <Window.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <h:BoolToCollapsedConverter x:Key="BoolVisInv" Invert="True" />
        <h:NullToCollapsedConverter x:Key="NullVis" />
    </Window.Resources>
    <DockPanel Margin="12" Background="{StaticResource WindowBg}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"><Run Text="Break down this tile: " /><Run Text="{Binding Map.Name, Mode=OneWay}" /><Run Text=", tile " /><Run Text="{Binding TileX, Mode=OneWay}" /><Run Text="," /><Run Text="{Binding TileY, Mode=OneWay}" /></TextBlock>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Every piece of the tile, by kind: the ground and its 256 chunks, the ground textures, the trees and objects, the buildings, the water and the rest. Select a piece to see it in the tile (the rest is dimmed) or on its own. Show in Browse opens its entry; Open in Blender edits it." />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,5" IsCancel="True" Click="Close_Click" />
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the list -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6">
                        <Button DockPanel.Dock="Right" Content="Collapse all" Command="{Binding CollapseAllCommand}" Padding="8,3" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Expand all" Command="{Binding ExpandAllCommand}" Padding="8,3" Margin="6,0,0,0" />
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="24,4,4,4"
                                     ToolTip="Search the pieces by name, file or detail (for example: palm, 33_48, river, hole)." />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                    <TreeView x:Name="Pieces" ItemsSource="{Binding Tree}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectedItemChanged="Pieces_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="1,2" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:BreakdownNode}" ItemsSource="{Binding Children}">
                                <DockPanel MaxWidth="390" ToolTip="{Binding Detail}">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,2,6,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="FontSize" Value="13" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the viewer -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource H2}" FontSize="17" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedDetail}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="View" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton x:Name="InTileButton" Style="{StaticResource Segment}" Content="In the tile" GroupName="BreakdownView" IsChecked="{Binding OnItsOwn, Converter={x:Static h:InverseBool.Instance}}"
                                         ToolTip="The whole tile in 3D with the selected piece highlighted and everything else dimmed." />
                            <RadioButton x:Name="OnItsOwnButton" Style="{StaticResource Segment}" Content="On its own" GroupName="BreakdownView" IsChecked="{Binding OnItsOwn}" Margin="0,0,14,0"
                                         ToolTip="Only the selected piece: a model in the model viewer's renderer, a building alone, a texture with its coverage map, the ground as a height heat map." />
                            <Button x:Name="ShowInBrowseButton" Command="{Binding ShowInBrowseCommand}" Padding="10,4" Margin="0,0,6,0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding BrowseHint}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                                    <TextBlock Text="Show in Browse" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenInBlenderButton" Command="{Binding OpenInBlenderCommand}" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource PrimaryButton}"
                                    ToolTipService.ShowOnDisabled="True" ToolTip="{Binding BlenderHint}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                                    <TextBlock Text="{Binding OpenInBlenderText}" />
                                </StackPanel>
                            </Button>
                            <Button Content="Focus (F)" Command="{Binding FocusCommand}" Padding="10,4" ToolTip="Bring the selected piece back into view." />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ViewNote}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <v:CameraBar DockPanel.Dock="Bottom" Viewport="{Binding ElementName=Viewport}" Margin="0,6,0,0" Visibility="{Binding ShowViewport, Converter={StaticResource BoolVis}}" />
                    <Grid>
                        <Border CornerRadius="6" Background="#FF2B3038" ClipToBounds="True" Visibility="{Binding ShowViewport, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <c:ModelViewport x:Name="Viewport" Terrain="{Binding ActiveTerrain}" Scene="{Binding ModelScene}" Camera="{Binding ActiveCamera}"
                                                 Navigation="{Binding Navigation}" ShowHelp="{Binding ShowHelp}"
                                                 ToolTip="Left-drag turns, right-drag moves, wheel zooms (Fly: W A S D and the mouse). H: all the controls." />
                                <Border Background="#C0101418" CornerRadius="4" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding Loading, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding Status}" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Visibility="{Binding HasImages, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasImageB}" Value="False">
                                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ImageALabel}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                                <Border Background="{StaticResource Checkerboard}" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding ImageA}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                            </DockPanel>
                            <DockPanel Grid.Column="2" Visibility="{Binding HasImageB, Converter={StaticResource BoolVis}}">
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ImageBLabel}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                                <Image Source="{Binding ImageB}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </DockPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
