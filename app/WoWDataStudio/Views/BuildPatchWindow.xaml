<Window x:Class="WoWDataStudio.Views.BuildPatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="releasing"
        Style="{StaticResource AppWindow}"
        Title="Build release patch (patch-3.MPQ)" Width="720" Height="560" MinHeight="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Build release patch (patch-3.MPQ)" Style="{StaticResource H1}" FontSize="22" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,6,0,12"
                   Text="All your changes are packed into one archive, patch-3.MPQ. The game loads it on top of its own archives, so it is the file to share or keep for a release. The game's own archives are never changed." />
        <StackPanel DockPanel.Dock="Bottom">
            <CheckBox x:Name="InstallBox" IsChecked="True" Margin="0,12,0,4">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="Also install it into the game:" />
                    <Run x:Name="DestRun" />
                </TextBlock>
            </CheckBox>
            <TextBlock x:Name="BackupNote" Style="{StaticResource Muted}" Margin="22,0,0,0" />
            <Border x:Name="ServerNoteBox" Background="{StaticResource WarnSoft}" CornerRadius="4" Padding="8,5" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ServerNoteText" TextWrapping="Wrap" Foreground="{StaticResource Warn}" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
                <Button Content="Build patch-3.MPQ" IsDefault="True" MinWidth="160" Style="{StaticResource PrimaryButton}" Click="Build_Click" />
            </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="CountText" Style="{StaticResource H3}" Margin="0,0,0,6" />
        <Border Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="FileList" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="File (game path)" Width="400" DisplayMemberBinding="{Binding Path}" />
                        <GridViewColumn Header="Format" Width="150" DisplayMemberBinding="{Binding Format}" />
                        <GridViewColumn Header="Edited" Width="120" DisplayMemberBinding="{Binding Edited}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
