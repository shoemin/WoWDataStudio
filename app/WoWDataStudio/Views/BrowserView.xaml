<UserControl x:Class="WoWDataStudio.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WoWDataStudio.Controls"
             xmlns:h="clr-namespace:WoWDataStudio.Helpers"
             xmlns:v="clr-namespace:WoWDataStudio.Views"
             xmlns:s="clr-namespace:WoWDataStudio.Services"
             s:Manual.Topic="main-window">
    <UserControl.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <h:BoolToCollapsedConverter x:Key="BoolVisInv" Invert="True" />
        <h:NullToCollapsedConverter x:Key="NullVis" />
        <h:NullToCollapsedConverter x:Key="NullVisInv" Invert="True" />

        <!-- compact action button content: glyph + title -->
        <DataTemplate x:Key="ActionTitle">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <!-- a tab that another version opened read only cannot have (no server, the designers): what and why -->
        <ControlTemplate x:Key="NotForThisVersion" TargetType="ContentControl">
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="680" Margin="30">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#FFB0B8C4" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,10,0,6" />
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Border>
        </ControlTemplate>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel>
            <!-- ============================== MENU ============================== -->
            <Menu DockPanel.Dock="Top" Background="White" Padding="4,2">
                <MenuItem Header="_File">
                    <MenuItem Header="Change World of Warcraft folder..." Command="{Binding DataContext.ChangeFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <MenuItem Header="Settings..." Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <MenuItem Header="Open another version (read only)..." Command="{Binding DataContext.OpenOtherVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="Another World of Warcraft version (such as the 1.60 Classic client) in this window, with the same tabs as your game. Read only: every write is greyed out with the reason." />
                    <MenuItem Header="Back to your 1.12 game" Command="{Binding DataContext.OpenOwnGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}"
                              ToolTip="Close the other version and open your 1.12 game folder again (the one of the settings)." />
                    <Separator />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Import edited model..." Command="{Binding ImportEditedModelCommand}"
                              ToolTip="Bring back a model you edited in Blender (or its PNG textures): you review every change before anything is saved." />
                    <Separator />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Build release patch (patch-3.MPQ)..." Command="{Binding BuildPatchCommand}" />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Open my workspace folder" Command="{Binding OpenWorkspaceFolderCommand}" />
                    <Separator />
                    <MenuItem h:WriteGuard.Reason="{Binding ServerRefusal}" Header="Reload names from the server database" Command="{Binding DataContext.RefreshServerNamesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <MenuItem Header="Rebuild the index" Command="{Binding DataContext.RebuildIndexCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="Open the 3D view in a new window" InputGestureText="Ctrl+Shift+O" Command="{Binding PopOutCommand}"
                              ToolTip="The 3D view of the selected model (Browse tab) or map tile (Maps tab) in a window of its own: bigger, on another monitor, or full screen." />
                    <MenuItem Header="Compare two skins of this model (3D)" Command="{Binding CompareSkinsCommand}"
                              ToolTip="Two synchronized 3D views side by side: the selected skin and another one (or, for a character, your look and the default one)." />
                    <Separator />
                    <MenuItem Header="Export for Blender..." Command="{Binding ExportModelCommand}" ToolTip="Export the model shown in the 3D view to Blender (glTF + PNG textures)." />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Import edited model..." Command="{Binding ImportEditedModelCommand}" />
                    <MenuItem Header="Install the Blender add-on..." Command="{Binding InstallBlenderAddonCommand}"
                              ToolTip="Builds the add-on zip and installs it into Blender 4.5 (after asking), or shows you where it is to install it yourself." />
                    <Separator />
                    <MenuItem Header="Maps and terrain" Command="{Binding ShowMapsCommand}" ToolTip="The Maps tab: maps, zones, tiles in 3D, editing in Noggit." />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Edit in Noggit..." Command="{Binding Maps.EditInNoggitCommand}" ToolTip="Prepare a Noggit project for the map selected in the Maps tab." />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Import map changes..." Command="{Binding Maps.ImportMapChangesCommand}" ToolTip="Review the files Noggit saved for the map selected in the Maps tab." />
                    <MenuItem h:WriteGuard.Reason="{Binding NotYetRefusal}" Header="Break down this tile..." Command="{Binding Maps.BreakDownTileCommand}" ToolTip="Every piece of the tile selected in the Maps tab, by kind, each viewable on its own." />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Open terrain in Blender..." Command="{Binding Maps.OpenTerrainInBlenderCommand}" ToolTip="Edit the ground heights of the selected tile and its neighbours in Blender." />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Import edited terrain..." Command="{Binding Maps.ImportEditedTerrainCommand}" ToolTip="Bring the heights edited in Blender back (seam check, review, one change set)." />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Update server maps..." Command="{Binding Maps.UpdateServerCommand}" ToolTip="Re-extract the server's terrain, collision and pathing and install them (guided)." />
                    <Separator />
                    <MenuItem Header="Data tables (DBC editor)" Command="{Binding ShowTablesCommand}" ToolTip="The Data tables tab: every DBC table of the game (spells, items, creatures, maps...) to view and edit." />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Copy tables to the server..." Command="{Binding Tables.CopyToServerCommand}" ToolTip="Copy your edited tables that the server reads into its dbc folder (guided, with a backup)." />
                    <Separator />
                    <MenuItem Header="Server data (world database)" Command="{Binding ShowServerCommand}" ToolTip="The Server data tab: the server's items, creatures, quests, spells, loot, vendors, trainers... to view and edit." />
                    <MenuItem h:WriteGuard.Reason="{Binding ServerRefusal}" Header="Check client and server..." Command="{Binding Server.CheckClientServerCommand}" ToolTip="The game's tables next to the server's: every difference, fixed in either direction." />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Apply to server..." Command="{Binding Server.ApplyToServerCommand}" ToolTip="Write your saved server edits into the world database (backed up, logged, undoable)." />
                    <MenuItem h:WriteGuard.Reason="{Binding WriteRefusal}" Header="Clear the game's cache (WDB)..." Command="{Binding Server.ClearWdbCommand}" ToolTip="Make the game ask the server again for items, creatures and quests." />
                    <Separator />
                    <MenuItem Header="Spell designer" Command="{Binding ShowSpellDesignerCommand}" ToolTip="Make or clone spells with a guided form: tooltip preview, checks, visuals, trainers; the game's and the server's spell rows in step." />
                    <MenuItem Header="Classes and talents" Command="{Binding ShowClassesCommand}" ToolTip="A class's talent trees on the grid, its spells by level, class masks, and a new class (experimental)." />
                    <MenuItem Header="Quest chains" Command="{Binding ShowQuestsCommand}" ToolTip="Quest chains as flowcharts, a quest editor in plain fields, branches and the other faction's chain, new quest givers on the map, checks; the server's quest rows." />
                    <Separator />
                    <MenuItem Header="Other versions (experimental)" Command="{Binding ShowVersionsCommand}" ToolTip="Read the data of other World of Warcraft versions (TBC, WotLK...): files, archives, data tables, a row compared across versions. Read only." />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="User manual" InputGestureText="F1" Command="{x:Static s:Manual.OpenCommand}" CommandParameter="index"
                              ToolTip="The full user manual, in your web browser. F1 opens the chapter of the screen you are on." />
                    <MenuItem Header="Troubleshooting and questions" Command="{x:Static s:Manual.OpenCommand}" CommandParameter="troubleshooting" />
                    <Separator />
                    <MenuItem Header="How it works" Command="{Binding ToggleHelpCommand}" />
                    <MenuItem Header="About the loose-file mode (LOOSE_FILES_PATCH.md)" Command="{Binding DataContext.OpenLooseFilesDocCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Separator />
                    <MenuItem Header="The command line (wds)" Command="{x:Static s:Manual.OpenCommand}" CommandParameter="command-line"
                              ToolTip="Every feature of the app as a command, for scripts and automation: the wds program installed next to the app." />
                    <MenuItem Header="About WoW Data Studio" Command="{Binding AboutCommand}" />
                </MenuItem>
            </Menu>

            <!-- ============================== TOP BAR ============================== -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="16,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="WoW Data Studio" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GameTitle}" Foreground="#CCFFFFFF" FontSize="11" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenSettingsCommand}" ToolTip="{Binding ServerTip}" Margin="12,0,8,0" Padding="10,5" Background="#22FFFFFF" BorderBrush="#55FFFFFF">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FFB0B8C4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ServerConnected}" Value="True"><Setter Property="Fill" Value="#FF4ADE80" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ServerStatusText}" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" Padding="10,5" Background="#22FFFFFF" BorderBrush="#55FFFFFF" Foreground="White"
                                ToolTip="Game folder and server database settings." />
                        <Button Command="{Binding ToggleHelpCommand}" Padding="10,5" Background="#22FFFFFF" BorderBrush="#55FFFFFF" ToolTip="How it works: the steps from finding a texture to putting it back into the game.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,1,6,0" />
                                <TextBlock Text="How it works" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid MaxWidth="760" HorizontalAlignment="Stretch" s:Manual.Topic="finding-things">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="34,7,8,7"
                                 BorderThickness="0" ToolTip="Type any words: names (Mottled Boar), file names (BoarSkinIvory), paths (Creature\Boar), ids (3098). All words must match." />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource TextMuted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Search models, textures, creatures, items..." FontSize="15" Foreground="#FF97A1AE" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource NullVisInv}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ============================== ANOTHER VERSION: READ ONLY ============================== -->
            <Border x:Name="ReadOnlyBanner" DockPanel.Dock="Top" Background="{StaticResource WarnSoft}" BorderBrush="#FFF59E0B" BorderThickness="0,0,0,1" Padding="16,7"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}" s:Manual.Topic="other-versions">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Back to your 1.12 game" Command="{Binding DataContext.OpenOwnGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Close the other version and open your 1.12 game folder again." />
                    <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Warn}" FontSize="15" Margin="0,1,10,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding WriteRefusal}">
                        <Run Text="Read only:" FontWeight="SemiBold" Foreground="{StaticResource Warn}" /> <Run Text="{Binding ReadOnlyBanner, Mode=OneWay}" Foreground="{StaticResource Warn}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- ============================== ANOTHER VERSION: LOCKED RECORDS, NAMES ============================== -->
            <Border x:Name="VersionStatus" DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,5"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}" s:Manual.Topic="other-versions">
                <StackPanel>
                    <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusLine}">
                        <Run Text="Locked (encrypted, no key)" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" /><Run Text=": " /><Run Text="{Binding StatusLine, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding NamesLine}" Foreground="{StaticResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding NamesLine}" />
                </StackPanel>
            </Border>

            <!-- ============================== FILTERS ============================== -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,10,16,4" s:Manual.Topic="finding-things">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Show:" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="{StaticResource TextMuted}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding OnlyMyChanges}" ToolTip="Only list textures you changed, and the creatures/items/characters that use them."
                                      Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVisInv}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Modified}" Margin="0,1,6,0" />
                                <TextBlock Text="Show only my changes" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Tip}" Content="{Binding Text}">
                                        <ToggleButton.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Show only this type" Command="{Binding PlacementTarget.Tag.OnlyKindCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Show all types" Command="{Binding PlacementTarget.Tag.SelectAllKindsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </ToggleButton.ContextMenu>
                                        <ToggleButton.Tag>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </ToggleButton.Tag>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="All" Command="{Binding SelectAllKindsCommand}" Margin="0,0,6,6" Padding="10,4" ToolTip="Tick every type. (Right-click a type to show only that one.)" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- ============================== TABS ============================== -->
            <TabControl SelectedIndex="{Binding SelectedTab}" Margin="12,10,12,12" Padding="0" BorderThickness="0" Background="Transparent">
                <TabItem Padding="14,6">
                    <TabItem.Header>
                        <TextBlock Text="Browse" FontWeight="SemiBold" />
                    </TabItem.Header>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="380" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1*" MinWidth="480" />
                        </Grid.ColumnDefinitions>

                        <!-- results -->
                        <Border Style="{StaticResource Card}" Padding="0" s:Manual.Topic="finding-things">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="12,8">
                                    <TextBlock Text="Click a row to see where it comes from and its textures. Click a column title to sort." DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ResultCountText}" FontWeight="SemiBold" FontSize="14" />
                                </DockPanel>
                                <ListView x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRow}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item"
                                          ScrollViewer.IsDeferredScrollingEnabled="False" SelectionMode="Single">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="ToolTip" Value="{Binding Info}" />
                                            <Setter Property="Padding" Value="2,3" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Width="200">
                                                <GridViewColumn.Header>
                                                    <Button Content="Name" Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Name" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="90">
                                                <GridViewColumn.Header>
                                                    <Button Content="Type" Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Type" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Type}" Foreground="{StaticResource TextMuted}" /></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="64">
                                                <GridViewColumn.Header>
                                                    <Button Content="ID" Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Id" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding IdText}" /></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="230">
                                                <GridViewColumn.Header>
                                                    <Button Content="File path" Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Path" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Path}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Status" Width="90">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Badge}" Background="#FFFFE7CC" Visibility="{Binding ShowBadge, Converter={StaticResource BoolVis}}" ToolTip="{Binding BadgeTip}">
                                                            <TextBlock Text="{Binding BadgeText}" Foreground="{StaticResource Modified}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- details -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                            <DockPanel>
                                <!-- actions: always visible at the bottom of the details panel -->
                                <Border DockPanel.Dock="Bottom" Background="#FFF7F9FC" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,6,6" Padding="12,8,12,8" s:Manual.Topic="editing-textures"
                                        Visibility="{Binding SelectedTexture, Converter={StaticResource NullVis}}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" TextTrimming="CharacterEllipsis">
                                            <Run Text="WHAT DO YOU WANT TO DO WITH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                            <Run Text="{Binding SelectedTexture.FileName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="?" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                        </TextBlock>
                                        <DockPanel Margin="0,0,0,6" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}">
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Warn}" Margin="0,2,6,0" />
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Warn}" ToolTip="{Binding WriteRefusal}"
                                                       Text="Only Export works here (a PNG, no .blp.json). Import, test in game, remove, revert and the release patch are greyed out: this version is open read only (hover over one for the reason)." />
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ActionButton}" Margin="0,0,6,6" Command="{Binding ExportTextureCommand}" IsEnabled="{Binding CanExport}"
                                                    ToolTip="Saves the texture as a PNG image plus a small .blp.json file that remembers where it came from (keep them together). The folder opens afterwards. Edit the PNG in any image editor."
                                                    ContentTemplate="{StaticResource ActionTitle}" Content="{x:Static h:Glyphs.Export}" />
                                            <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Grid.Row="0" Grid.Column="1" Style="{StaticResource ActionButton}" Margin="0,0,6,6" Command="{Binding ImportTextureCommand}" IsEnabled="{Binding CanImport}"
                                                    ToolTip="Pick your edited PNG. It is checked (size, transparency) and converted to the game's format; you see a before/after comparison and decide whether to keep it. Nothing is saved before that."
                                                    ContentTemplate="{StaticResource ActionTitle}" Content="{x:Static h:Glyphs.Import}" />
                                            <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Grid.Row="0" Grid.Column="2" Style="{StaticResource ActionButton}" Margin="0,0,0,6" Command="{Binding CompareCommand}" IsEnabled="{Binding CanCompare}"
                                                    ToolTip="Original (from game) vs. your edit: side by side, slider, toggle, or a difference heat map. Available after you imported an edit of this texture."
                                                    ContentTemplate="{StaticResource ActionTitle}" Content="{x:Static h:Glyphs.Compare}" />
                                            <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Grid.Row="1" Grid.Column="0" Style="{StaticResource ActionButton}" Margin="0,0,6,6" Command="{Binding TestInGameCommand}" IsEnabled="{Binding CanTestInGame}"
                                                    ToolTip="Copies your edited texture into the game's Data folder as a loose file. Needs the client's loose-file mode (see How it works). Restart the game to see it."
                                                    ContentTemplate="{StaticResource ActionTitle}" Content="{x:Static h:Glyphs.TestInGame}" />
                                            <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionButton}" Margin="0,0,6,6" Command="{Binding RemoveFromGameCommand}" IsEnabled="{Binding CanRemoveFromGame}"
                                                    ToolTip="Deletes the loose copy that 'Test in game' installed. Your edit stays in your workspace."
                                                    ContentTemplate="{StaticResource ActionTitle}" Content="{x:Static h:Glyphs.Remove}" />
                                            <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionButton}" Margin="0,0,0,6" Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert}"
                                                    ToolTip="Deletes your edited copy so the game's original is used again (also removes it from the game folder if it was installed)."
                                                    ContentTemplate="{StaticResource ActionTitle}" Content="{x:Static h:Glyphs.Revert}" />
                                            <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Grid.ColumnSpan="3" Grid.Row="2" Grid.Column="0" Style="{StaticResource ActionButton}" Margin="0" Command="{Binding BuildPatchCommand}" IsEnabled="{Binding HasChanges}"
                                                    ToolTip="Packs ALL your changes into Data\patch-3.MPQ, the file to keep or share for a release. An existing patch-3.MPQ is backed up first. You see the list of files before anything is written."
                                                    ContentTemplate="{StaticResource ActionTitle}" Content="{x:Static h:Glyphs.BuildPatch}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisInv}}">
                                    <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#FFB0B8C4" HorizontalAlignment="Center" />
                                    <TextBlock Text="Select something in the list" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="360"
                                               Text="Search above (for example: mottled boar, orc male, worn battleaxe, durotar palm), then click a result. Its details, textures and the actions appear here." />
                                </StackPanel>
                                <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                    <StackPanel Margin="16,14">
                                        <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource H2}" FontSize="20" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetailSubtitle}" Style="{StaticResource Muted}" />

                                        <TextBlock Text="WHERE IT COMES FROM" Style="{StaticResource H3}" FontSize="11" />
                                        <ItemsControl ItemsSource="{Binding Chain}" AlternationCount="1000">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock x:Name="arrow" Text="&#x2192;" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                                        <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="7,2">
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="460" />
                                                        </Border>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                            <Setter TargetName="arrow" Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Facts}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <TextBlock DockPanel.Dock="Left" Text="&#x2022;" Margin="2,0,8,0" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- another version: the files with FileDataID, name source, state (ViewModels\BrowserViewModel.Versions.cs) -->
                                        <StackPanel x:Name="FilesBox" Visibility="{Binding HasFiles, Converter={StaticResource BoolVis}}" s:Manual.Topic="other-versions">
                                            <TextBlock Style="{StaticResource H3}" FontSize="11">
                                                <Run Text="FILES" /> <Run Text="{Binding Files.Count, Mode=OneWay, StringFormat=({0})}" />
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1" ToolTip="{Binding Tip}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MinWidth="70" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding FileDataId}" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis"><Run Text="{Binding FileName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Role, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="11" /></TextBlock>
                                                            <TextBlock Grid.Column="2" Text="{Binding NameSource}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
                                                            <Border Grid.Column="3" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                                        <Setter Property="Background" Value="{StaticResource GoodSoft}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Background" Value="{StaticResource WarnSoft}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- used in game (Views\UsedInGameView, ViewModels\BrowserViewModel.UsedInGame.cs) -->
                                        <Expander x:Name="UsedInGameBox" Margin="0,10,0,0" IsExpanded="{Binding UsedInGameExpanded}" s:Manual.Topic="used-in-game">
                                            <Expander.Header>
                                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="Used in game" FontWeight="SemiBold" /><Run Text="{Binding UsedInGame.ShortText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" /></TextBlock>
                                            </Expander.Header>
                                            <v:UsedInGameView x:Name="UsedInGamePanel" DataContext="{Binding UsedInGame}" Margin="4,4,0,0" />
                                        </Expander>

                                        <!-- 3D model viewer -->
                                        <Border Visibility="{Binding IsModelEntry, Converter={StaticResource BoolVis}}" Margin="0,12,0,0" s:Manual.Topic="model-viewer">
                                            <v:ModelViewerView x:Name="ModelViewer" DataContext="{Binding ModelViewer}" />
                                        </Border>

                                        <!-- another version: the building preview of a WMO (groups and textures by FileDataID) -->
                                        <Border x:Name="BuildingBox" Visibility="{Binding IsBuildingEntry, Converter={StaticResource BoolVis}}" Margin="0,12,0,0" s:Manual.Topic="other-versions">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Right" Command="{Binding ResetBuildingViewCommand}" Padding="10,4" VerticalAlignment="Bottom" Content="Reset view"
                                                            ToolTip="Back to the start view (or double-click the view)." />
                                                    <TextBlock Text="BUILDING (3D)" Style="{StaticResource H3}" FontSize="11" VerticalAlignment="Bottom" Margin="0" />
                                                </DockPanel>
                                                <!-- the 3D view is made the first time a building is shown (code-behind): a GL view costs a context -->
                                                <Border x:Name="BuildingHost" CornerRadius="6" Background="#FF2B3038" Height="380" ClipToBounds="True" />
                                                <TextBlock Text="{Binding BuildingStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- model actions (Phase 3c: Blender round trip) -->
                                        <Border x:Name="ModelActions" Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="#FFF7F9FC" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                Visibility="{Binding ModelViewer.HasModel, Converter={StaticResource BoolVis}}" s:Manual.Topic="model-export-import">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#FFFFE7CC" Visibility="{Binding ModelViewer.IsModelModified, Converter={StaticResource BoolVis}}"
                                                            ToolTip="You imported an edited mesh of this model; the 3D view shows your version.">
                                                        <TextBlock Text="Modified" Foreground="{StaticResource Modified}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="EDIT THE MODEL IN BLENDER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Warn}" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}"
                                                           Text="Export for Blender and Open in Blender work (the package goes to a folder you choose). Importing, comparing and reverting are greyed out: they change files of the game that is open, and this version is open read only." />
                                                <WrapPanel>
                                                    <Button Content="Export for Blender..." Command="{Binding ExportModelCommand}" Margin="0,0,6,6" Padding="10,4"
                                                            ToolTip="Saves the model (mesh, skeleton, animations) as glTF with its textures as PNG and a manifest, in one package folder. Choose the current skin, all skins, or one file per skin." />
                                                    <Button Content="Open in Blender" Command="{Binding OpenModelInBlenderCommand}" Margin="0,0,6,6" Padding="10,4"
                                                            ToolTip="Exports the look shown now and starts Blender 4.5 with it imported by the WoW add-on." />
                                                    <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Content="Import edited model..." Command="{Binding ImportEditedModelCommand}" Margin="0,0,6,6" Padding="10,4" Style="{StaticResource PrimaryButton}"
                                                            ToolTip="Pick the package folder or the file Blender exported. You see every change (mesh, each texture) with checks and a Compare button, and choose what to keep." />
                                                    <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Content="Compare original vs. edited model" Command="{Binding CompareModelCommand}" Margin="0,0,6,6" Padding="10,4"
                                                            IsEnabled="{Binding ModelViewer.IsModelModified}" ToolTip="Two synchronized 3D views: the game's model and your edited one, with the same animation." />
                                                    <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Content="Revert the model" Command="{Binding RevertModelCommand}" Margin="0,0,6,6" Padding="10,4"
                                                            IsEnabled="{Binding ModelViewer.IsModelModified}" ToolTip="Deletes your edited mesh: the game's model is used again." />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- textures -->
                                        <TextBlock Style="{StaticResource H3}" FontSize="11">
                                            <Run Text="TEXTURES IT USES" /> <Run Text="{Binding Textures.Count, Mode=OneWay, StringFormat=({0})}" />
                                        </TextBlock>
                                        <TextBlock Text="No textures: the game chooses them at run time, or the entry has none." Style="{StaticResource Muted}"
                                                   Visibility="{Binding Textures.Count, Converter={StaticResource NullVisInv}}" />
                                        <ListBox x:Name="TextureList" ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTexture}" MaxHeight="170" BorderBrush="{StaticResource Border}"
                                                 Visibility="{Binding Textures.Count, Converter={StaticResource NullVis}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel ToolTip="{Binding Tip}" Margin="0,1">
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#FFFFE7CC" Visibility="{Binding IsModified, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="Modified" Foreground="{StaticResource Modified}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Role}" Foreground="{StaticResource TextMuted}" Margin="8,0" FontSize="12" />
                                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,2,6,0" DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- texture viewer -->
                                        <Border x:Name="TextureViewerBox" s:Manual.Topic="texture-viewer" Margin="0,12,0,0" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10"
                                                Visibility="{Binding SelectedTexture, Converter={StaticResource NullVis}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Viewer.IsModified, Converter={StaticResource BoolVis}}">
                                                        <RadioButton Style="{StaticResource Segment}" Content="Your edit" IsChecked="{Binding Viewer.ShowEdited}" GroupName="vshow" ToolTip="Show your edited version." />
                                                        <RadioButton Style="{StaticResource Segment}" Content="Original" IsChecked="{Binding Viewer.ShowEdited, Converter={x:Static h:InverseBool.Instance}}" GroupName="vshow" ToolTip="Show the game's original." />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SelectedTexture.FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Viewer.ShowingLabel}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <Grid Height="330" Margin="0,8,0,6">
                                                    <c:ZoomPanViewer x:Name="TexViewer" Source="{Binding Viewer.Image}" View="{Binding Viewer.View}" Checkerboard="{Binding Viewer.Checkerboard}" CornerRadius="4" />
                                                    <TextBlock Text="{Binding Viewer.Error}" Foreground="#FFFFB4A9" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Grid>
                                                <WrapPanel>
                                                    <ComboBox SelectedIndex="{Binding Viewer.AlphaView, Converter={x:Static h:AlphaViewIndex.Instance}}" Width="215" Margin="0,0,8,4" ToolTip="How transparent pixels are shown.">
                                                        <ComboBoxItem Content="Transparency: checkerboard" />
                                                        <ComboBoxItem Content="Transparency: ignore (colour only)" />
                                                        <ComboBoxItem Content="Alpha channel only" />
                                                    </ComboBox>
                                                    <TextBlock Text="Mip level" VerticalAlignment="Center" Margin="0,0,4,4" Foreground="{StaticResource TextMuted}" />
                                                    <ComboBox ItemsSource="{Binding Viewer.Levels}" SelectedItem="{Binding Viewer.MipLevel}" Width="52" Margin="0,0,8,4"
                                                              ToolTip="Smaller copies of the texture that the game shows at a distance. 0 = full size." />
                                                    <Button Content="Fit" Click="Fit_Click" Margin="0,0,4,4" Padding="8,3" ToolTip="Fit the texture into the view (or double-click it)." />
                                                    <Button Content="100%" Click="Actual_Click" Margin="0,0,6,4" Padding="8,3" ToolTip="One texture pixel per screen pixel." />
                                                    <TextBlock Text="{Binding Viewer.View.ZoomText}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                                </WrapPanel>
                                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="Format: " Foreground="{StaticResource TextMuted}" /><Run Text="{Binding Viewer.FormatInfo, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Viewer.SizeInfo}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />
                                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}">
                                                    <Run Text="{Binding Viewer.SourceInfo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedTexture.Path, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- used by -->
                                        <Expander Margin="0,8,0,0" IsExpanded="True" Visibility="{Binding UsedBy.Count, Converter={StaticResource NullVis}}">
                                            <Expander.Header>
                                                <TextBlock FontWeight="SemiBold"><Run Text="Used by" /> <Run Text="{Binding UsedBy.Count, Mode=OneWay, StringFormat=({0})}" /></TextBlock>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding UsedBy}" Margin="4,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,1" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================== MY CHANGES ============================== -->
                <TabItem Padding="14,6" s:Manual.Topic="my-changes">
                    <TabItem.Header>
                        <TextBlock Text="{Binding ChangesTabText}" FontWeight="SemiBold" />
                    </TabItem.Header>
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="My changes" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                           Text="Every file you changed. Your edits live in your workspace until you install them: 'Test in game' copies them into the game folder as loose files, 'Build release patch' packs them into patch-3.MPQ. The game's own archives are never changed." />
                                <Border Background="{StaticResource WarnSoft}" CornerRadius="4" Padding="8,5" Margin="0,0,0,10" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="12">
                                        <Run Text="Another version has no workspace and no changes. " /><Run Text="{Binding WriteRefusal, Mode=OneWay}" /><Run Text=" Your 1.12 changes are kept: File &gt; Back to your 1.12 game shows them." />
                                    </TextBlock>
                                </Border>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Content="Test all in game (install as loose files)" Command="{Binding InstallAllLooseCommand}" IsEnabled="{Binding HasChanges}" Margin="0,0,8,4"
                                            ToolTip="Copy every edited file into the game folder as loose files." />
                                    <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Content="Remove all from game" Command="{Binding RemoveAllFromGameCommand}" Margin="0,0,8,4"
                                            ToolTip="Delete every loose file this app installed in the game folder." />
                                    <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Content="Reload in running game" Command="{Binding ReloadInGameCommand}" Margin="0,0,8,4"
                                            ToolTip="Hot reload: the running game reads your installed changes again, without a restart. Needs the game started from this folder with hot reload switched on (Settings) and the project's own client. You see what is live now and what needs a relog or a restart." />
                                    <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Content="Build release patch (patch-3.MPQ)..." Command="{Binding BuildPatchCommand}" IsEnabled="{Binding HasChanges}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" />
                                    <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Content="Uninstall release patch (patch-3.MPQ)" Command="{Binding UninstallPatchCommand}" IsEnabled="{Binding HasInstalledPatch}" Margin="0,0,8,4"
                                            ToolTip="Take the release patch-3.MPQ out of the game folder and put back the patch-3.MPQ that was there before (if there was one). A patch-3.MPQ that WoW Data Studio did not create is only moved out after asking you." />
                                    <Button h:WriteGuard.Reason="{Binding WriteRefusal}" Content="Open my workspace folder" Command="{Binding OpenWorkspaceFolderCommand}" Margin="0,0,8,4" />
                                </WrapPanel>
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="8,5" Margin="0,0,0,10" Visibility="{Binding HasInstalledPatch, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding PatchStateText}" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding HotReloadText}" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="12"
                                           ToolTip="Hot reload: whether the game runs from this folder and can read changed files again without a restart (checked every few seconds).">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HotReloadReady}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Grid>
                                <TextBlock Text="No changes yet. Find a texture, export it, edit the PNG and import it again: it will be listed here."
                                           Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasChanges, Converter={StaticResource BoolVisInv}}" />
                                <ListView ItemsSource="{Binding Changes}" BorderBrush="{StaticResource Border}" Visibility="{Binding HasChanges, Converter={StaticResource BoolVis}}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="File" Width="240">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel ToolTip="{Binding Path}">
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding UsedBy}" Foreground="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Status" Width="270">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Status}" TextWrapping="Wrap" /></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Format" Width="140" DisplayMemberBinding="{Binding Format}" />
                                            <GridViewColumn Header="Edited" Width="115" DisplayMemberBinding="{Binding Edited}" />
                                            <GridViewColumn Header="Import" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding SetLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" /></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Actions" Width="420">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Compare" Padding="8,3" Margin="0,0,4,0" Command="{Binding DataContext.CompareChangeCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"
                                                                    ToolTip="Compare original vs. edited." />
                                                            <Button Content="Show" Padding="8,3" Margin="0,0,4,0" Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"
                                                                    ToolTip="Show this texture in the Browse tab." />
                                                            <Button Content="Revert" Padding="8,3" Margin="0,0,4,0" Command="{Binding DataContext.RevertChangeCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"
                                                                    ToolTip="Undo this file's change." />
                                                            <Button Content="Revert this import" Padding="8,3" Command="{Binding DataContext.RevertChangeSetCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"
                                                                    ToolTip="Undo every file that came with the same import: each goes back to the version it had before it (your earlier edit, or the game's original)." />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- ============================== MAPS ============================== -->
                <TabItem Padding="14,6" s:Manual.Topic="maps-and-terrain">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" />
                            <TextBlock Text="Maps" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <v:MapsView x:Name="MapsScreen" DataContext="{Binding Maps}" />
                </TabItem>

                <!-- ============================== DATA TABLES (0.7.0) ============================== -->
                <TabItem Padding="14,6" s:Manual.Topic="dbc-editor">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" />
                            <TextBlock Text="Data tables" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <v:DbcEditorView x:Name="TablesScreen" DataContext="{Binding Tables}"
                                         Visibility="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisInv}}" />
                        <!-- another version: its DB2 tables, read only (ViewModels\VersionTablesViewModel) -->
                        <v:VersionTablesView x:Name="VersionTablesScreen" DataContext="{Binding VersionTables}" s:Manual.Topic="other-versions"
                                             Visibility="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </TabItem>

                <!-- ============================== SERVER DATA (0.9.0) ============================== -->
                <TabItem Padding="14,6" s:Manual.Topic="server-data">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" />
                            <TextBlock Text="Server data" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <v:ServerDataView x:Name="ServerScreen" DataContext="{Binding Server}"
                                          Visibility="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisInv}}" />
                        <ContentControl x:Name="NoServerPanel" Template="{StaticResource NotForThisVersion}" Content="No server connected" Tag="{Binding ServerMissingText}" s:Manual.Topic="other-versions"
                                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </TabItem>

                <!-- ============================== SPELL DESIGNER (0.12.0) ============================== -->
                <TabItem Padding="14,6" s:Manual.Topic="spell-designer">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" />
                            <TextBlock Text="Spell designer" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <v:SpellDesignerView x:Name="SpellsScreen" DataContext="{Binding Spells}"
                                  Visibility="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisInv}}" />
                        <ContentControl Template="{StaticResource NotForThisVersion}" Content="Read only" Tag="{Binding DesignerMissingText}" s:Manual.Topic="other-versions"
                                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </TabItem>

                <!-- ============================== CLASSES AND TALENTS (0.12.0) ============================== -->
                <TabItem Padding="14,6" s:Manual.Topic="class-and-talent-designer">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" />
                            <TextBlock Text="Classes and talents" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <v:ClassTalentView x:Name="ClassesScreen" DataContext="{Binding Classes}"
                                  Visibility="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisInv}}" />
                        <ContentControl Template="{StaticResource NotForThisVersion}" Content="Read only" Tag="{Binding DesignerMissingText}" s:Manual.Topic="other-versions"
                                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </TabItem>

                <!-- ============================== QUEST CHAINS (0.13.0) ============================== -->
                <TabItem Padding="14,6" s:Manual.Topic="quest-chain-designer">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" />
                            <TextBlock Text="Quest chains" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <v:QuestDesignerView x:Name="QuestsScreen" DataContext="{Binding Quests}"
                                  Visibility="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisInv}}" />
                        <ContentControl Template="{StaticResource NotForThisVersion}" Content="Read only" Tag="{Binding DesignerMissingText}" s:Manual.Topic="other-versions"
                                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </TabItem>

                <!-- ============================== OTHER VERSIONS (0.14.0, experimental) ============================== -->
                <TabItem Padding="14,6" s:Manual.Topic="other-versions">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" />
                            <TextBlock Text="Other versions" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <v:OtherVersionsView x:Name="VersionsScreen" DataContext="{Binding Versions}" />
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- ============================== HELP PANEL ============================== -->
        <Border HorizontalAlignment="Right" Width="400" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" s:Manual.Topic="index"
                Visibility="{Binding HelpOpen, Converter={StaticResource BoolVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.25" />
            </Border.Effect>
            <DockPanel Margin="20">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Close" Command="{Binding ToggleHelpCommand}" />
                    <TextBlock Text="How it works" Style="{StaticResource H2}" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource AccentSoft}" CornerRadius="5" Padding="10,8" Margin="0,0,0,4">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="This is the short version. Every feature is explained step by step in the" />
                                <Hyperlink Command="{x:Static s:Manual.OpenCommand}" CommandParameter="index">user manual</Hyperlink><Run Text=". Press F1 on any screen to open its chapter." />
                            </TextBlock>
                        </Border>
                        <TextBlock Style="{StaticResource H3}" Text="1. Find it" />
                        <TextBlock TextWrapping="Wrap" Text="Type in the search box: a creature name (Mottled Boar), an item (Worn Battleaxe), a race (orc male), a file name (BoarSkinIvory) or a path. Use the type buttons to narrow the list. Click a result: the panel on the right shows where it comes from (creature → display → model → skin) and the textures it uses." />
                        <TextBlock Style="{StaticResource H3}" Text="2. Export" />
                        <TextBlock TextWrapping="Wrap" Text="Pick a texture and click 'Export texture as PNG'. A PNG and a small .blp.json file are saved; keep them together. The folder opens." />
                        <TextBlock Style="{StaticResource H3}" Text="3. Edit" />
                        <TextBlock TextWrapping="Wrap" Text="Edit the PNG in any image editor (GIMP, Krita, Photoshop, Paint.NET...). Keep the size (for example 256 x 256) and keep transparent areas transparent." />
                        <TextBlock Style="{StaticResource H3}" Text="4. Import and check" />
                        <TextBlock TextWrapping="Wrap" Text="Click 'Import edited PNG'. The app converts it to the game's format (only the parts you changed are re-encoded) and shows the original and your edit side by side. Click 'Keep this change' to save it in your workspace. Nothing in the game is changed yet." />
                        <TextBlock Style="{StaticResource H3}" Text="5. Test in game" />
                        <TextBlock TextWrapping="Wrap" Text="'Test in game' copies the file into the game's Data folder as a loose file. The game reads loose files only with its loose-file mode on: the project's own client has it from update wave185 on (a normal 1.12.1 client ignores loose files; use 'Build release patch' there). Restart the game to see it; 'Remove from game' takes it out again." />
                        <TextBlock Margin="0,4,0,0">
                            <Hyperlink Command="{Binding DataContext.OpenLooseFilesDocCommand, RelativeSource={RelativeSource AncestorType=Window}}">Read about the loose-file mode</Hyperlink>
                        </TextBlock>
                        <TextBlock Style="{StaticResource H3}" Text="6. Release" />
                        <TextBlock TextWrapping="Wrap" Text="'Build release patch' packs all your changes into Data\patch-3.MPQ (an existing one is backed up first). That one file carries your changes; the game's own archives are never modified." />
                        <TextBlock Style="{StaticResource H3}" Text="Undo" />
                        <TextBlock TextWrapping="Wrap" Text="'Revert my change' deletes your edited copy (and its loose copy in the game folder). The 'My changes' tab lists every change with its status; 'Revert this import' undoes all files of one import." />
                        <TextBlock Style="{StaticResource H3}" Text="Maps" />
                        <TextBlock TextWrapping="Wrap" Text="The Maps tab shows the game's maps, zones and tiles, and any tile in 3D. 'Edit in Noggit' prepares the map editor Noggit (a separate program) for the tile; save there, then 'Import map changes' checks every file against the 1.12 rules and shows the tile before and after. Test or release as for textures, then 'Update server maps' so the server's terrain, collision and pathing match." />
                        <TextBlock Style="{StaticResource H3}" Text="Data tables" />
                        <TextBlock TextWrapping="Wrap" Text="The Data tables tab shows the game's database files (DBC): spells, icons, items, creatures, maps, flight paths, talents, sounds... Pick a table, find a row (search, filters, Go to ID), click a link to jump to the row it points at, and edit values with checks. 'Save to my workspace' puts the table into My changes; test or release it like a texture. Tables the server reads too get 'Copy to server...'." />
                        <TextBlock Style="{StaticResource H3}" Text="Server data" />
                        <TextBlock TextWrapping="Wrap" Text="The Server data tab shows your server's world database: items, creatures, quests, game objects, spells, loot, vendors, trainers, areas, maps, flight paths, factions and languages. Every link opens what it names. Edits are checked and go into your workspace (My changes); 'Export SQL patch' or 'Apply to server' delivers them (backed up, undoable). 'Check client and server' compares the game's tables with the server's. Restart the world server afterwards, and clear the game's cache." />
                        <TextBlock Style="{StaticResource H3}" Text="Good to know" />
                        <TextBlock TextWrapping="Wrap" Text="• A texture is often shared: the Mottled Boar's skin is also used by other boars. The details panel says who else uses it.&#x0a;• Names of creatures, items and game objects come from your server's database when it is running (top right). Otherwise things are listed by model and id.&#x0a;• Models are shown in 3D with their animations and skins; edit them in Blender with 'Export for Blender' and 'Import edited model'." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
