<Window x:Class="WoWDataStudio.Views.ServerCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="server-data"
        Style="{StaticResource AppWindow}"
        Title="Check client and server" Width="1150" Height="760" MinWidth="760" MinHeight="460" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Check client and server" Style="{StaticResource H1}" FontSize="20" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                   Text="The game and the server keep some data twice: the server reads spells, maps, areas, factions, faction templates, flight points and skills from its database, the game from its data tables; items and creatures name their looks in the game's tables. Pick a difference and make the two sides match, in either direction. Server edits wait in the Server data tab until you save them; game table edits go into your workspace at once (like a Data tables edit)." />
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Check" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="AreaBox" Width="170" Margin="0,0,12,0" />
            <TextBlock Text="Only these IDs (optional)" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="IdsBox" Width="160" Margin="0,0,12,0" Padding="3" ToolTip="IDs separated by commas, for example 133,143." />
            <Button x:Name="RunButton" Content="Run the check" Style="{StaticResource PrimaryButton}" Click="Run_Click" Padding="12,4" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="100" Margin="8,0,0,0" Click="Close_Click" />
            <Button DockPanel.Dock="Right" x:Name="ClientButton" Content="Make the game match the server" Click="MatchClient_Click" Margin="8,0,0,0" Padding="10,4"
                    ToolTip="The game's table takes the server's values (saved into your workspace; test it or build the release patch)." />
            <Button DockPanel.Dock="Right" x:Name="ServerButton" Content="Make the server match the game" Click="MatchServer_Click" Margin="8,0,0,0" Padding="10,4"
                    ToolTip="The server's row takes the game's values (an edit in the Server data tab: save it, then apply)." />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
        </DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>
            <ListView x:Name="IssueList" SelectionMode="Extended" SelectionChanged="IssueList_SelectionChanged" BorderBrush="{StaticResource Border}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="What" Width="120" DisplayMemberBinding="{Binding Area}" />
                        <GridViewColumn Header="ID" Width="80" DisplayMemberBinding="{Binding Id}" />
                        <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Difference" Width="240" DisplayMemberBinding="{Binding KindText}" />
                        <GridViewColumn Header="Tables" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock><Run Text="{Binding ServerTable, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding ClientTable, Mode=OneWay}" /></TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" x:Name="AdviceText" TextWrapping="Wrap" Margin="0,0,0,4" />
                <ListView x:Name="FieldList" BorderBrush="{StaticResource Border}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Server column" Width="220" DisplayMemberBinding="{Binding ServerColumn}" />
                            <GridViewColumn Header="On the server" Width="300" DisplayMemberBinding="{Binding ServerValue}" />
                            <GridViewColumn Header="Game column" Width="200" DisplayMemberBinding="{Binding ClientColumn}" />
                            <GridViewColumn Header="In the game" Width="300" DisplayMemberBinding="{Binding ClientValue}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
