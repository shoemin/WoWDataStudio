<UserControl x:Class="WoWDataStudio.Views.DbcDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="RowList" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" SelectionChanged="RowList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Change" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KindText}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Modified}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding KindText}" Value="Added"><Setter Property="Foreground" Value="{StaticResource Good}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding KindText}" Value="Removed"><Setter Property="Foreground" Value="{StaticResource Bad}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="ID" Width="80" DisplayMemberBinding="{Binding Key}" />
                        <GridViewColumn Header="Row" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="What changed" Width="560">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding DetailsText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailsText}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="CellTitle" Text="Click a changed row to see its values before and after." Margin="10,6" Foreground="{StaticResource TextMuted}" />
                <ListView x:Name="CellList" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Column" Width="200" DisplayMemberBinding="{Binding Column}" />
                            <GridViewColumn Header="Before (the game)" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Before}" TextWrapping="Wrap" Foreground="{StaticResource Bad}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="After (yours)" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding After}" TextWrapping="Wrap" Foreground="{StaticResource Good}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
