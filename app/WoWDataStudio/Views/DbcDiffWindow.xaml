<Window x:Class="WoWDataStudio.Views.DbcDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WoWDataStudio.Views"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="dbc-editor"
        Style="{StaticResource AppWindow}"
        Title="Compare table" Width="1100" Height="700" MinWidth="700" MinHeight="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" x:Name="TitleText" Style="{StaticResource H1}" FontSize="20" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" x:Name="IntroText" TextWrapping="Wrap" Margin="0,6,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Close" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="170" IsDefault="True" Click="Primary_Click" />
        </StackPanel>
        <v:DbcDiffView x:Name="Diff" />
    </DockPanel>
</Window>
