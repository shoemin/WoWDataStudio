<Window x:Class="WoWDataStudio.Views.MapConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:WoWDataStudio.Helpers"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="other-versions"
        Style="{StaticResource AppWindow}"
        Title="Convert map" Width="1180" Height="800" MinWidth="860" MinHeight="520" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <h:InverseBoolConverter x:Key="Not" />
    </Window.Resources>
    <DockPanel Margin="16" Background="{StaticResource WindowBg}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource H1}" FontSize="20" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Experimental. The tiles are converted into your workspace as one change set (Revert this import in My changes takes it all back); your game folder is not changed. Textures and models your 1.12 game has are used as they are; new ground textures are converted; models and buildings 1.12 does not have are left out and listed. Your 1.12 shadows are kept where the ground did not change." />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Close" IsCancel="True" MinWidth="100" Margin="0,0,8,0" ToolTip="Close the window. A preview writes nothing." />
                <Button Content="Convert" MinWidth="150" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanConvert}" Click="Convert_Click"
                        ToolTip="Save the converted files into your workspace as one change set (after a Preview of the same choice)." />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Bad}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                    <TextBlock Text="Map" Style="{StaticResource H3}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}" DisplayMemberPath="Label"
                              ToolTip="The maps of that client that have terrain (name, ID, folder)." />
                    <TextBlock Text="What to convert" Style="{StaticResource H3}" Margin="0,14,0,4" />
                    <RadioButton Content="A zone and its subzones" IsChecked="{Binding ByZone}" GroupName="what" Margin="0,2"
                                 ToolTip="Every tile with ground of this zone or one of its subzones (whole tiles: their other zones change too)." />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Zones}" Text="{Binding ZoneText, UpdateSourceTrigger=PropertyChanged}" Margin="22,2,0,6"
                              IsEnabled="{Binding ByZone}" ToolTip="The zone's name or its AreaTable ID in that client." />
                    <RadioButton Content="These tiles" IsChecked="{Binding ByTiles}" GroupName="what" Margin="0,2"
                                 ToolTip="Tiles as x_y, separated by commas (for example 32_48,33_48)." />
                    <TextBox Text="{Binding TilesText, UpdateSourceTrigger=PropertyChanged}" Margin="22,2,0,6" IsEnabled="{Binding ByTiles}" />
                    <RadioButton Content="The whole map" IsChecked="{Binding WholeMap}" GroupName="what" Margin="0,2"
                                 ToolTip="Every tile of the map. A map 1.12 does not have becomes a new map (a new Map row, its folder named after the map)." />
                    <TextBlock Text="{Binding NamesText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Preview" Command="{Binding PreviewCommand}" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="0,0,8,0"
                                ToolTip="Convert in memory and show the conversion report. Nothing is written." />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding StopCommand}" Padding="10,3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                                ToolTip="Stop the preview or the conversion (nothing is written when it stops)." />
                        <TextBlock Text="Conversion report" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
