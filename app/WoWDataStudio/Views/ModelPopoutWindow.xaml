<Window x:Class="WoWDataStudio.Views.ModelPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WoWDataStudio.Controls"
        xmlns:v="clr-namespace:WoWDataStudio.Views"
        xmlns:h="clr-namespace:WoWDataStudio.Helpers"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="model-viewer"
        Title="{Binding WindowTitle}" Width="1280" Height="860" MinWidth="480" MinHeight="360"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner">
    <!-- The model pop-out window (0.5.1, docs\manual\model-viewer.md#open-in-a-new-window). DataContext = ModelPopoutViewModel. -->
    <Window.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="6,0,0,4" />
        </Style>
    </Window.Resources>
    <DockPanel Background="{StaticResource WindowBg}" ClipToBounds="True">
        <!-- tool bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6,10,2"
                Visibility="{Binding ShowToolbar, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding Viewer.SaveImageCommand}" ToolTip="Save the 3D view as a PNG image.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                            <TextBlock Text="Save image..." />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleSidePanelCommand}" ToolTip="Open or close the side panel with the animation, skin and display controls.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE89F;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                            <TextBlock Text="{Binding PanelText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleControlsCommand}" ToolTip="Hide the tool bar and the side panel: only the 3D view (Ctrl+H brings them back).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                            <TextBlock Text="Hide controls" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding FullScreenCommand}" ToolTip="The whole screen for the 3D view (F11; Esc leaves full screen).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FullScreenGlyph}" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                            <TextBlock Text="{Binding FullScreenText}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FollowSelection}" Margin="0,0,8,4"
                                  ToolTip="On: this window shows what you select in the main window. Off (pinned): it keeps showing this model, so you can open several windows side by side to compare.">
                        <TextBlock Text="Follow selection" />
                    </ToggleButton>
                    <TextBlock Text="{Binding FollowText}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,4" />
                    <v:CameraBar Viewport="{Binding ElementName=Viewport}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="PanelColumn" Width="400" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- the 3D view -->
            <Grid Background="#FF2B3038">
                <c:ModelViewport x:Name="Viewport" Scene="{Binding Viewer.Scene}" Camera="{Binding Viewer.Camera}" Navigation="{Binding Navigation}"
                                 ShowHelp="{Binding ShowHelp}" WindowKeys="True" />
                <Border Background="#B0000000" CornerRadius="4" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Viewer.IsLoading, Converter={StaticResource BoolVis}}" IsHitTestVisible="False">
                    <TextBlock Text="Loading the model..." Foreground="White" />
                </Border>
                <TextBlock Text="{Binding Viewer.Message}" Foreground="#FFFFC9C2" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextAlignment="Center" IsHitTestVisible="False" />
                <Border Background="#A0101418" CornerRadius="4" Padding="8,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                    <TextBlock Text="{Binding WindowTitle}" Foreground="White" FontWeight="SemiBold" />
                </Border>
                <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,3" Opacity="0.85" Style="{StaticResource BaseButton}"
                        Command="{Binding ToggleControlsCommand}" Visibility="{Binding ControlsHidden, Converter={StaticResource BoolVis}}"
                        ToolTip="Bring back the tool bar and the side panel (Ctrl+H).">
                    <TextBlock Text="Show controls (Ctrl+H)" />
                </Button>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Border}" ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding ShowPanel, Converter={StaticResource BoolVis}}" />

            <!-- side panel: the same controls as the docked viewer -->
            <ScrollViewer x:Name="SidePanel" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White"
                          Visibility="{Binding ShowPanel, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="12,10" DataContext="{Binding Viewer}">
                    <v:ModelVariantPicker />
                    <v:ModelViewerControls />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
