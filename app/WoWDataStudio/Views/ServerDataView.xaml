<UserControl x:Class="WoWDataStudio.Views.ServerDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WoWDataStudio.Controls"
             xmlns:h="clr-namespace:WoWDataStudio.Helpers"
             xmlns:s="clr-namespace:WoWDataStudio.Services"
             s:Manual.Topic="server-data">
    <UserControl.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <h:BoolToCollapsedConverter x:Key="BoolVisInv" Invert="True" />
        <h:NullToCollapsedConverter x:Key="NullVis" />
        <h:NullToCollapsedConverter x:Key="NullVisInv" Invert="True" />
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>

    <DockPanel Margin="0,8,0,0">
        <!-- ============================== connection and the actions ============================== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Center" Background="{StaticResource AccentSoft}">
                        <TextBlock Text="{Binding DirtyText}" FontSize="12" />
                    </Border>
                    <Button DockPanel.Dock="Right" Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,8,0" Padding="9,3"
                            ToolTip="Connect to the server's world database again (after changing the settings or starting the database)." />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run Text="Server data" FontWeight="SemiBold" FontSize="15" /><Run Text="   " /><Run Text="{Binding ConnectionText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                    </TextBlock>
                </DockPanel>
                <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding IsConnected}">
                    <Button Content="Add new" Command="{Binding AddNewCommand}" Style="{StaticResource ToolButton}" ToolTip="A new row of the view's table with the first free ID of your custom ID range (Settings)." />
                    <Button Content="Duplicate as new" Command="{Binding DuplicateAsNewCommand}" Style="{StaticResource ToolButton}" ToolTip="A copy of the shown row with a free ID of your custom ID range." />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}" ToolTip="Delete the shown row (you are told first what refers to it)." />
                    <Button Content="Bulk edit..." Command="{Binding BulkEditCommand}" Style="{StaticResource ToolButton}" ToolTip="Set, add to or multiply a column of every row of the list." />
                    <Button Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Style="{StaticResource ToolButton}" ToolTip="{Binding UndoText}">
                        <TextBlock><Run Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" /> <Run Text="Undo" /></TextBlock>
                    </Button>
                    <Button Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Style="{StaticResource ToolButton}" ToolTip="{Binding RedoText}">
                        <TextBlock><Run Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" /> <Run Text="Redo" /></TextBlock>
                    </Button>
                    <Button Content="Save to my workspace" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Padding="10,4"
                            ToolTip="Keep your server edits (Ctrl+S): they go into your workspace and My changes. The server is not changed yet." />
                    <Button Content="Discard changes" Command="{Binding DiscardCommand}" IsEnabled="{Binding IsDirty}" Style="{StaticResource ToolButton}" ToolTip="Throw away the server edits you have not saved." />
                    <Button Content="Compare with the server" Command="{Binding CompareWithServerCommand}" Style="{StaticResource ToolButton}" ToolTip="Every row you changed: the server's values and yours." />
                    <Button Content="Export the list..." Command="{Binding ExportListCommand}" Style="{StaticResource ToolButton}" ToolTip="Save the rows of the list as CSV (spreadsheets) or JSON." />
                    <Button Content="Import..." Command="{Binding ImportCommand}" Style="{StaticResource ToolButton}" ToolTip="Bring a CSV or JSON file back into the view's table: you see every change first." />
                    <Button Content="Check client and server..." Command="{Binding CheckClientServerCommand}" Style="{StaticResource ToolButton}"
                            ToolTip="The game's tables next to the server's (spells, looks, maps, areas, factions, flight paths, skills): every difference, fixed in either direction." />
                    <Button Content="Export SQL patch..." Command="{Binding ExportSqlPatchCommand}" Style="{StaticResource ToolButton}" ToolTip="Your saved server edits as an .sql file that can be run more than once, with its revert script." />
                    <Button Content="Apply to server..." Command="{Binding ApplyToServerCommand}" Style="{StaticResource ToolButton}"
                            ToolTip="Write your saved server edits into the world database: the statements first, a backup of every affected row, one transaction, a log." />
                    <Button Content="Undo last apply" Command="{Binding UndoLastApplyCommand}" Style="{StaticResource ToolButton}" ToolTip="Put the rows of the last apply back as they were before it (from its backup)." />
                    <Button Content="Applied changes log" Command="{Binding AppliedLogCommand}" Style="{StaticResource ToolButton}" ToolTip="Every apply to the server and its undo, with the backup folders." />
                    <Button Content="Clear the game's cache (WDB)..." Command="{Binding ClearWdbCommand}" Style="{StaticResource ToolButton}"
                            ToolTip="The game keeps the server's items, creatures and quests in its WDB folder: clear it so it shows your edits." />
                </WrapPanel>
                <TextBlock Text="{Binding EditsText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- status line -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <ProgressBar DockPanel.Dock="Right" Width="80" Height="6" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" />
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Bad}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="430" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ============================== views and the list ============================== -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                        <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView}" DisplayMemberPath="Label" ToolTip="What to look at: items, creatures, quests, spells, loot, vendors..." />
                        <TextBlock Text="{Binding ViewAbout}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6" />
                        <DockPanel Visibility="{Binding HasSubTables, Converter={StaticResource BoolVis}}" Margin="0,0,0,6">
                            <TextBlock Text="Table" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
                            <ComboBox ItemsSource="{Binding SubTables}" SelectedItem="{Binding SelectedSubTable}" />
                        </DockPanel>
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="24,4,4,4"
                                     ToolTip="A name (all words must appear) or an ID." />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock Text="Search by name or ID..." Foreground="#FF97A1AE" Margin="25,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource NullVisInv}}" />
                        </Grid>
                        <TextBlock Text="{Binding ResultsText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,1" ToolTip="{Binding Key}">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Id, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontWeight="Normal" /></TextBlock>
                                    <TextBlock Text="{Binding Info}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ============================== the record's values ============================== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock Text="Pick something in the list on the left (or connect to the server's database first)." Style="{StaticResource Muted}" FontSize="14" Margin="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding HasRecord, Converter={StaticResource BoolVisInv}}" />
                    <ScrollViewer x:Name="ValuesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasRecord, Converter={StaticResource BoolVis}}">
                        <StackPanel Margin="14,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" Padding="9,3" VerticalAlignment="Top"
                                        ToolTip="Back to what you looked at before (after following a link)." />
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailSubtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="8,4" Margin="0,6,0,0" Visibility="{Binding RecordEdited, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="You changed this row (in your edits; the server still has its own values until you apply)." TextWrapping="Wrap" FontSize="12" />
                            </Border>
                            <WrapPanel Margin="0,6,0,0" Visibility="{Binding HasVersions, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Versions:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
                                <ItemsControl ItemsSource="{Binding Versions}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Info}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,0,10,0"
                                                    Command="{Binding DataContext.OpenVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                            <TextBlock Text="{Binding ReloadText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Show in Browse" Command="{Binding ShowInBrowseCommand}" Visibility="{Binding CanShowInBrowse, Converter={StaticResource BoolVis}}" Padding="9,3" Margin="0,0,6,0"
                                        ToolTip="Open it in the Browse tab: its 3D model, textures and Used in game." />
                            </StackPanel>
                            <!-- icon -->
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,8,0,0" HorizontalAlignment="Left" Width="140"
                                    Visibility="{Binding HasPreview, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <Grid Height="110">
                                        <c:ZoomPanViewer Source="{Binding Preview.Image}" View="{Binding Preview.View}" Checkerboard="{Binding Preview.Checkerboard}" CornerRadius="4" />
                                    </Grid>
                                    <TextBlock Text="{Binding PreviewPath}" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ProblemsText}" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding ProblemsText, Converter={StaticResource NullVis}}" />

                            <TextBlock Text="Values" Style="{StaticResource H3}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Edit a value and press Enter (\N is NULL). Choices and flags have their names; a link opens the row it names. Grey names are not described yet: their value is shown as the database stores it." />
                            <ItemsControl ItemsSource="{Binding FieldGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,2,0,4" FontWeight="SemiBold">
                                            <ItemsControl ItemsSource="{Binding Fields}" FontWeight="Normal" Margin="4,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel ToolTip="{Binding Tip}" Margin="0,2,8,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Verified}" Value="False">
                                                                                    <Setter Property="Foreground" Value="#FF8A94A3" />
                                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding TypeText}" FontSize="10" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=Explicit}" KeyDown="Field_KeyDown" LostKeyboardFocus="Field_LostFocus"
                                                                         Visibility="{Binding IsPlainBox, Converter={StaticResource BoolVis}}" TextWrapping="Wrap" MaxHeight="120" Padding="3,2" />
                                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" DisplayMemberPath="Text" Visibility="{Binding IsEnum, Converter={StaticResource BoolVis}}" />
                                                                <CheckBox IsChecked="{Binding BoolValue}" Content="Yes" Visibility="{Binding IsBool, Converter={StaticResource BoolVis}}" Margin="0,3,0,0" />
                                                                <TextBlock Text="{Binding Display}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                                                           Visibility="{Binding ShowsExtra, Converter={StaticResource BoolVis}}" />
                                                                <Button Content="{Binding LinkText}" Command="{Binding FollowLinkCommand}" Visibility="{Binding HasLink, Converter={StaticResource BoolVis}}" FontSize="11" Margin="0,1,0,0"
                                                                        ToolTip="Open the row this value links to.">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding LinkMissing}" Value="True"><Setter Property="Foreground" Value="{StaticResource Bad}" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Expander Header="Flags" Visibility="{Binding IsFlags, Converter={StaticResource BoolVis}}" FontSize="11" Margin="0,2,0,0">
                                                                    <ItemsControl ItemsSource="{Binding Flags}" Margin="16,2,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate><CheckBox Content="{Binding Text}" IsChecked="{Binding IsOn}" Margin="0,1" /></DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Expander>
                                                                <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Visibility="{Binding Hint, Converter={StaticResource NullVis}}" />
                                                                <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Bad}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding HasProblem, Converter={StaticResource BoolVis}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ============================== related rows, the game's side, used by ============================== -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer x:Name="RelatedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasRecord, Converter={StaticResource BoolVis}}">
                    <StackPanel Margin="14,10">
                        <!-- the game's side -->
                        <StackPanel Visibility="{Binding HasClient, Converter={StaticResource BoolVis}}" Margin="0,0,0,10">
                            <TextBlock Text="In the game (client)" Style="{StaticResource H3}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding ClientText}" TextWrapping="Wrap" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <Button Content="Check client and server..." Command="{Binding CheckClientServerCommand}" Padding="8,3"
                                        ToolTip="Make the server match the game, or the game match the server." />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ClientFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ServerColumn}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ClientColumn}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ServerValue}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="The server's value" Margin="4,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding ClientValue}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="The game's value" Margin="4,0" />
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Same}" Value="False"><Setter Property="Background" Value="#FFFFF4E5" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- related rows -->
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,4,0,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding TableText}" />
                                            <WrapPanel Margin="0,2,0,0">
                                                <Button Content="Add row here" Padding="6,1" FontSize="11" Margin="0,0,4,2" Visibility="{Binding CanAdd, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.AddInSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        ToolTip="A new row of this list (its link to the shown row already set)." />
                                                <Button Content="Bulk edit..." Padding="6,1" FontSize="11" Margin="0,0,4,2" Visibility="{Binding HasRows, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.BulkEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="Export this list..." Padding="6,1" FontSize="11" Margin="0,0,4,2" Visibility="{Binding HasRows, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.ExportSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="Import..." Padding="6,1" FontSize="11" Margin="0,0,4,2"
                                                        Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        ToolTip="Import a CSV or JSON file into this list (with a preview)." />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource Warn}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}" />
                                            <ItemsControl ItemsSource="{Binding Rows}" Margin="4,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Text}" Style="{StaticResource LinkButton}" FontSize="11" Margin="0,1" ToolTip="Open this row"
                                                                Command="{Binding DataContext.OpenSectionRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- used by -->
                        <TextBlock Text="Used by" Style="{StaticResource H3}" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding UsedByText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding UsedBy}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,1"
                                            Command="{Binding DataContext.OpenUsedByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
