<Window x:Class="WoWDataStudio.Views.TerrainPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WoWDataStudio.Controls"
        xmlns:v="clr-namespace:WoWDataStudio.Views"
        xmlns:h="clr-namespace:WoWDataStudio.Helpers"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="maps-and-terrain"
        Title="{Binding WindowTitle}" Width="1400" Height="900" MinWidth="480" MinHeight="360"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner">
    <!-- The terrain pop-out window (0.5.1, docs\manual\maps-and-terrain.md#open-in-a-new-window). DataContext = TerrainPopoutViewModel. -->
    <Window.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="6,0,0,4" />
        </Style>
    </Window.Resources>
    <DockPanel Background="{StaticResource WindowBg}" ClipToBounds="True">
        <!-- tool bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6,10,2"
                Visibility="{Binding ShowToolbar, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button x:Name="BreakDownButton" Style="{StaticResource ToolButton}" Command="{Binding BreakDownCommand}" Visibility="{Binding CanBreakDown, Converter={StaticResource BoolVis}}"
                            ToolTip="Every piece of the tile shown here, by kind (ground, chunks, textures, trees, buildings, water...), each viewable on its own.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                            <TextBlock Text="Break down this tile..." />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleSidePanelCommand}" ToolTip="Open or close the side panel with the tile's display switches.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE89F;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                            <TextBlock Text="{Binding PanelText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleControlsCommand}" ToolTip="Hide the tool bar and the side panel: only the 3D view (Ctrl+H brings them back).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                            <TextBlock Text="Hide controls" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding FullScreenCommand}" ToolTip="The whole screen for the 3D view (F11; Esc leaves full screen).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FullScreenGlyph}" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                            <TextBlock Text="{Binding FullScreenText}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FollowSelection}" Margin="0,0,8,4"
                                  ToolTip="On: this window shows the tile you select in the Maps tab. Off (pinned): it keeps showing this tile, so you can open several windows side by side to compare.">
                        <TextBlock Text="Follow selection" />
                    </ToggleButton>
                    <TextBlock Text="{Binding FollowText}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,4" />
                    <v:CameraBar Viewport="{Binding ElementName=Viewport}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PanelColumn" Width="300" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- the 3D view -->
            <Grid Background="#FF2B3038">
                <c:ModelViewport x:Name="Viewport" Terrain="{Binding Scene}" Camera="{Binding Camera}" Navigation="{Binding Navigation}"
                                 ShowHelp="{Binding ShowHelp}" WindowKeys="True" />
                <Border Background="#A0101418" CornerRadius="4" Padding="8,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                    <TextBlock Text="{Binding WindowTitle}" Foreground="White" FontWeight="SemiBold" />
                </Border>
                <Border Background="#C0101418" CornerRadius="4" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding Loading, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Status}" Foreground="White" />
                </Border>
                <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,3" Opacity="0.85" Style="{StaticResource BaseButton}"
                        Command="{Binding ToggleControlsCommand}" Visibility="{Binding ControlsHidden, Converter={StaticResource BoolVis}}"
                        ToolTip="Bring back the tool bar and the side panel (Ctrl+H).">
                    <TextBlock Text="Show controls (Ctrl+H)" />
                </Button>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Border}" ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding ShowPanel, Converter={StaticResource BoolVis}}" />

            <!-- side panel -->
            <ScrollViewer x:Name="SidePanel" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White"
                          Visibility="{Binding ShowPanel, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="12,10">
                    <TextBlock Text="SHOW" Style="{StaticResource H3}" FontSize="11" Margin="0,0,0,6" />
                    <CheckBox Content="Neighbour tiles" IsChecked="{Binding IncludeNeighbours}" Margin="0,0,0,6" ToolTip="Also show the 8 tiles around this one (slower)." />
                    <CheckBox Content="Doodads" IsChecked="{Binding ShowDoodads}" Margin="0,0,0,6" ToolTip="Trees, rocks, fences... (M2 models, shown without animation)." />
                    <CheckBox Content="Buildings" IsChecked="{Binding ShowWmos}" Margin="0,0,0,6" ToolTip="WMO buildings (simple rendering)." />
                    <CheckBox Content="Water" IsChecked="{Binding ShowWater}" Margin="0,0,0,6" />
                    <CheckBox Content="Textures" IsChecked="{Binding ShowTextures}" Margin="0,0,0,6" ToolTip="Untick to see the shape of the ground only." />
                    <CheckBox Content="Wireframe" IsChecked="{Binding Wireframe}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="FLYING" Style="{StaticResource H3}" FontSize="11" Margin="0,4,0,6" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12"
                               Text="In Fly mode: W A S D or the arrow keys move, Q / E go down / up, hold Shift to go faster. Hold the right mouse button and move the mouse to look around. The mouse wheel sets the speed (shown in the bottom-right corner). F brings the selected tile back into view. H shows all the keys." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
