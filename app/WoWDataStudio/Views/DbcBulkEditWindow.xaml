<Window x:Class="WoWDataStudio.Views.DbcBulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="dbc-editor"
        Style="{StaticResource AppWindow}"
        Title="Bulk edit" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                   Text="Change one column of every selected row at once. Every new value is checked first; if one is not allowed, nothing is changed. It is one step: Undo reverts all of it." />
        <TextBlock Text="Column" FontWeight="SemiBold" />
        <ComboBox x:Name="ColumnBox" DisplayMemberPath="Name" Margin="0,4,0,4" SelectionChanged="Column_Changed" />
        <TextBlock x:Name="ColumnHint" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="What to do" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
            <RadioButton x:Name="SetRadio" Content="Set to" IsChecked="True" Margin="0,0,16,0" />
            <RadioButton x:Name="AddRadio" Content="Add" Margin="0,0,16,0" />
            <RadioButton x:Name="MultiplyRadio" Content="Multiply by" />
        </StackPanel>
        <TextBlock Text="Value" FontWeight="SemiBold" />
        <TextBox x:Name="ValueBox" Margin="0,4,0,8" Padding="4" />
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{StaticResource Bad}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" MinWidth="150" IsDefault="True" Click="Apply_Click" />
        </StackPanel>
    </StackPanel>
</Window>
