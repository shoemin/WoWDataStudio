<UserControl x:Class="WoWDataStudio.Views.DbcEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WoWDataStudio.Controls"
             xmlns:h="clr-namespace:WoWDataStudio.Helpers"
             xmlns:s="clr-namespace:WoWDataStudio.Services"
             s:Manual.Topic="dbc-editor">
    <UserControl.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <h:BoolToCollapsedConverter x:Key="BoolVisInv" Invert="True" />
        <h:NullToCollapsedConverter x:Key="NullVis" />
        <h:NullToCollapsedConverter x:Key="NullVisInv" Invert="True" />
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding GoToIdCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="180" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="400" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ============================== THE TABLES ============================== -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                    <TextBlock Text="Data tables" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="The game's database files (DBC): spells, items, creatures, maps, sounds... Pick a table to see and edit its rows." />
                    <Grid>
                        <TextBox x:Name="TableFilterBox" Text="{Binding TableFilter, UpdateSourceTrigger=PropertyChanged}" Padding="24,4,4,4"
                                 ToolTip="Type part of a table's name or of what it is for (spell, icon, mount, flight...)." />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <CheckBox Content="Only tables I changed" IsChecked="{Binding OnlyModifiedTables}" Margin="0,6,0,0"
                              ToolTip="List only the tables that are in your workspace (My changes)." />
                    <TextBlock Text="{Binding ListText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <ListBox x:Name="TableList" SelectedItem="{Binding SelectedTable}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="6,8,0,2" FontSize="12" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding Tip}" Margin="2,1">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource Modified}" Margin="6,0,0,0"
                                        Visibility="{Binding IsModified, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="Modified" Foreground="White" FontSize="10" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ServerBadge, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CoverageText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- ============================== THE TABLE ============================== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Center" Background="{StaticResource AccentSoft}">
                            <TextBlock Text="{Binding DirtyText}" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding TableTitle}" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="{Binding TableAbout}" TextWrapping="Wrap" Margin="0,2,0,2" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12">
                        <Run Text="{Binding SourceText, Mode=OneWay}" /> <Run Text="{Binding OverrideText, Mode=OneWay}" />
                    </TextBlock>
                    <Border x:Name="ServerBox" Background="{StaticResource WarnSoft}" CornerRadius="5" Padding="10,6" Margin="0,6,0,0" Visibility="{Binding HasTable, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Copy to server..." Command="{Binding CopyToServerCommand}" VerticalAlignment="Center" Margin="10,0,0,0" Padding="9,4"
                                    Visibility="{Binding CanCopyToServer, Converter={StaticResource BoolVis}}"
                                    ToolTip="Copy your edited tables into the server's dbc folder (backed up first; refused while the world server runs)." />
                            <Button DockPanel.Dock="Right" Content="Edit it in the Server data tab" Command="{Binding OpenServerTableCommand}" VerticalAlignment="Center" Margin="10,0,0,0" Padding="9,4"
                                    Visibility="{Binding IsServerDatabaseTable, Converter={StaticResource BoolVis}}"
                                    ToolTip="The server keeps this data in its own database table: open it in the Server data tab (and compare it with this table there)." />
                            <StackPanel>
                                <TextBlock Text="{Binding ServerBadge}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ServerText}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Expander Margin="0,4,0,0" Header="{Binding CoverageText}" ToolTip="How much of this table's layout is named, and where it comes from."
                              Visibility="{Binding HasTable, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding EvidenceText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="20,2,0,4" />
                    </Expander>

                    <!-- search, go to, language -->
                    <WrapPanel Margin="0,8,0,0">
                        <Grid Width="260" Margin="0,0,8,6">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="24,4,4,4"
                                     ToolTip="Search every column of every row (all words must appear in a row)." />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock Text="Search all text..." Foreground="#FF97A1AE" Margin="25,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource NullVisInv}}" />
                        </Grid>
                        <TextBlock Text="Go to ID" VerticalAlignment="Center" Margin="0,0,4,6" Foreground="{StaticResource TextMuted}" />
                        <TextBox Text="{Binding GoToIdText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,4,6" Padding="4">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding GoToIdCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="Go" Command="{Binding GoToIdCommand}" Style="{StaticResource ToolButton}" ToolTip="Select the row with this ID (Ctrl+G)." />
                        <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ToolButton}" ToolTip="Show every row again (clears the search and the column filters)." />
                        <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" Style="{StaticResource ToolButton}" ToolTip="Back to the row you came from (after following a link)." />
                        <TextBlock Text="Language" VerticalAlignment="Center" Margin="6,0,4,6" Foreground="{StaticResource TextMuted}" />
                        <ComboBox ItemsSource="{Binding LocaleNames}" SelectedIndex="{Binding Locale}" Width="72" Margin="0,0,0,6"
                                  ToolTip="The language of the localized texts you see and edit. The other languages are kept as they are." />
                    </WrapPanel>

                    <!-- actions -->
                    <WrapPanel>
                        <Button Content="Add row" Command="{Binding AddRowCommand}" Style="{StaticResource ToolButton}" ToolTip="A new empty row with the next free ID." />
                        <Button Content="Duplicate as new" Command="{Binding DuplicateRowCommand}" Style="{StaticResource ToolButton}" ToolTip="A copy of the selected row with the next free ID." />
                        <Button Content="Delete rows" Command="{Binding DeleteRowsCommand}" Style="{StaticResource ToolButton}" ToolTip="Delete the selected rows (you are warned when other rows use them)." />
                        <Button Content="Bulk edit..." Command="{Binding OpenBulkEditCommand}" Style="{StaticResource ToolButton}" ToolTip="Set, add to or multiply a column of all selected rows." />
                        <Button Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Style="{StaticResource ToolButton}" ToolTip="{Binding UndoText}">
                            <TextBlock><Run Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" /> <Run Text="Undo" /></TextBlock>
                        </Button>
                        <Button Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Style="{StaticResource ToolButton}" ToolTip="{Binding RedoText}">
                            <TextBlock><Run Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" /> <Run Text="Redo" /></TextBlock>
                        </Button>
                        <Button x:Name="ExportButton" Content="Export ▾" Click="Export_Click" Style="{StaticResource ToolButton}" ToolTip="Save rows as CSV (spreadsheets) or JSON.">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Export all rows..." Command="{Binding ExportCommand}" CommandParameter="All" />
                                    <MenuItem Header="Export the rows shown..." Command="{Binding ExportCommand}" CommandParameter="Shown" ToolTip="Only the rows the search and the filters show." />
                                    <MenuItem Header="Export the selected rows..." Command="{Binding ExportCommand}" CommandParameter="Selected" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="Import..." Command="{Binding ImportCommand}" Style="{StaticResource ToolButton}" ToolTip="Bring a CSV or JSON file back: you see every change first." />
                        <Button Content="Compare with game" Command="{Binding CompareWithGameCommand}" Style="{StaticResource ToolButton}" ToolTip="Your version and the game's file, row by row." />
                        <Button Content="Save to my workspace" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Padding="10,4"
                                ToolTip="Keep your changes (Ctrl+S): they go into your workspace and My changes." />
                        <Button Content="Discard changes" Command="{Binding DiscardCommand}" IsEnabled="{Binding IsDirty}" Style="{StaticResource ToolButton}" ToolTip="Throw away the unsaved changes." />
                        <Button Content="Test in game" Command="{Binding TestInGameCommand}" Style="{StaticResource ToolButton}" ToolTip="Install this table as a loose file into the game folder." />
                        <Button Content="Build release patch..." Command="{Binding BuildPatchCommand}" Style="{StaticResource ToolButton}" ToolTip="Pack all your changes into patch-3.MPQ." />
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,4,0,4" Visibility="{Binding Message, Converter={StaticResource NullVis}}" />
                </StackPanel>

                <!-- status line -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding RowCountText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding SortText}" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0" />
                    <ProgressBar DockPanel.Dock="Right" Width="80" Height="6" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Bad}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>

                <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE9EDF2" BorderBrush="{StaticResource Border}"
                          RowHeight="24" FrozenColumnCount="1" Background="White"
                          Sorting="Grid_Sorting" CellEditEnding="Grid_CellEditEnding" SelectionChanged="Grid_SelectionChanged" PreparingCellForEdit="Grid_PreparingCellForEdit">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                    <Setter Property="Background" Value="#FFFFF4E5" />
                                    <Setter Property="ToolTip" Value="This row differs from the game's file." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- ============================== THE ROW ============================== -->
        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,10">
                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailSubtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <!-- preview -->
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <Grid Height="190">
                                <c:ZoomPanViewer x:Name="PreviewViewer" Source="{Binding Preview.Image}" View="{Binding Preview.View}" Checkerboard="{Binding Preview.Checkerboard}" CornerRadius="4" />
                                <TextBlock Text="{Binding Preview.Error}" Foreground="#FFFFB4A9" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding PreviewPath}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="{Binding ModelText}" Command="{Binding ShowModelCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="9,4"
                            Visibility="{Binding ModelText, Converter={StaticResource NullVis}}" ToolTip="Open it in the Browse tab with the 3D viewer." />
                    <ItemsControl ItemsSource="{Binding PreviewFiles}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource LinkButton}" FontSize="11" Margin="0,1"
                                        Command="{Binding DataContext.ShowFileFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        ToolTip="Show this file (pictures here, models in the Browse tab)." />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- the values -->
                    <TextBlock Text="Values" Style="{StaticResource H3}" Visibility="{Binding DetailTitle, Converter={StaticResource NullVis}}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding DetailTitle, Converter={StaticResource NullVis}}"
                               Text="Edit a value and press Enter. Point at a name for what it means. Grey names are not verified: their meaning is a guess, the value is shown as stored." />
                    <ItemsControl x:Name="FieldList" ItemsSource="{Binding Fields}" VirtualizingPanel.IsVirtualizing="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel ToolTip="{Binding Tip}" Margin="0,2,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Verified}" Value="False">
                                                            <Setter Property="Foreground" Value="#FF8A94A3" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TypeText}" FontSize="10" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=Explicit}" KeyDown="Field_KeyDown" LostKeyboardFocus="Field_LostFocus"
                                                 Visibility="{Binding IsPlainBox, Converter={StaticResource BoolVis}}" TextWrapping="Wrap" MaxHeight="120" Padding="3,2" />
                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" Visibility="{Binding IsEnum, Converter={StaticResource BoolVis}}" />
                                        <CheckBox IsChecked="{Binding BoolValue}" Content="Yes" Visibility="{Binding IsBool, Converter={StaticResource BoolVis}}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Extra}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Visibility="{Binding Extra, Converter={StaticResource NullVis}}" />
                                        <Button Content="{Binding LinkText}" Command="{Binding FollowLinkCommand}" Visibility="{Binding HasLink, Converter={StaticResource BoolVis}}" FontSize="11" Margin="0,1,0,0"
                                                ToolTip="Open the row this value links to.">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LinkMissing}" Value="True"><Setter Property="Foreground" Value="{StaticResource Bad}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Expander Header="Flags" Visibility="{Binding IsFlags, Converter={StaticResource BoolVis}}" FontSize="11" Margin="0,2,0,0">
                                            <ItemsControl ItemsSource="{Binding Flags}" Margin="16,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><CheckBox Content="{Binding Text}" IsChecked="{Binding IsOn}" Margin="0,1" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                        <ItemsControl ItemsSource="{Binding Files}" Visibility="{Binding HasFiles, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource LinkButton}" FontSize="11"
                                                            Command="{Binding DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=Grid}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Expander Header="Other languages" Visibility="{Binding HasOtherLocales, Converter={StaticResource BoolVis}}" FontSize="11">
                                            <ItemsControl ItemsSource="{Binding OtherLocales}" Margin="16,2,0,0" />
                                        </Expander>
                                        <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Bad}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding Problem, Converter={StaticResource NullVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- used by -->
                    <TextBlock Text="Used by" Style="{StaticResource H3}" Margin="0,12,0,2" Visibility="{Binding DetailTitle, Converter={StaticResource NullVis}}" />
                    <TextBlock Text="{Binding UsedByText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding UsedBy}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Text}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,1"
                                        Command="{Binding DataContext.OpenUsedByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
