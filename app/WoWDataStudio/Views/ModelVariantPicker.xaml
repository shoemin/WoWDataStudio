<UserControl x:Class="WoWDataStudio.Views.ModelVariantPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:WoWDataStudio.Helpers">
    <!-- The skin / item display picker of the 3D viewer (above the docked view, in the pop-out side panel). DataContext = ModelViewerViewModel. -->
    <UserControl.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>
    <StackPanel Visibility="{Binding HasVariants, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
        <TextBlock Text="{Binding VariantHeader}" Style="{StaticResource H3}" FontSize="11" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" MaxDropDownHeight="420"
                  ToolTip="Pick a display: the model is shown with that display's skin.">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding VariantNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
    </StackPanel>
</UserControl>
