<UserControl x:Class="WoWDataStudio.Views.ModelViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WoWDataStudio.Controls"
             xmlns:v="clr-namespace:WoWDataStudio.Views"
             xmlns:h="clr-namespace:WoWDataStudio.Helpers">
    <!-- The docked 3D viewer of the details panel (docs\manual\model-viewer.md). The skin picker and the controls are
         shared with the pop-out window (ModelPopoutWindow). -->
    <UserControl.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <h:NullToCollapsedConverter x:Key="NullVis" />
    </UserControl.Resources>

    <StackPanel>
        <!-- skin picker -->
        <v:ModelVariantPicker />

        <!-- viewport -->
        <Border CornerRadius="6" Background="#FF2B3038" ClipToBounds="True">
            <Grid x:Name="ViewportHost" Height="430">
                <c:ModelViewport x:Name="Viewport" Scene="{Binding Scene}" Camera="{Binding Camera}" Navigation="{Binding Navigation}" ShowHelp="{Binding ShowHelp}"
                                 SuspendAnimation="{Binding PausedForPopout}" />
                <Border Background="#B0000000" CornerRadius="4" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" IsHitTestVisible="False">
                    <TextBlock Text="Loading the model..." Foreground="White" />
                </Border>
                <TextBlock Text="{Binding Message}" Foreground="#FFFFC9C2" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Text="Drag: turn · Right-drag: move · Wheel: zoom · Double-click: reset · H: help" Foreground="#99FFFFFF" FontSize="11" Margin="8,6"
                           VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False" Visibility="{Binding HasModel, Converter={StaticResource BoolVis}}" />
                <!-- pop out -->
                <Button x:Name="PopOutButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,3" Command="{Binding PopOutCommand}"
                        Style="{StaticResource BaseButton}" Opacity="0.92"
                        Visibility="{Binding PopOutCommand, Converter={StaticResource NullVis}}"
                        ToolTip="Open the 3D view in a window of its own, to make it bigger, put it on another monitor or show it full screen (Ctrl+Shift+O).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                        <TextBlock Text="Open in new window" />
                    </StackPanel>
                </Button>
                <!-- shown in a following pop-out window -->
                <Border Background="#D0101418" CornerRadius="4" Padding="10,6" Margin="8,44,8,8" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="330"
                        Visibility="{Binding PausedForPopout, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12"
                                   Text="Also shown in a pop-out window that follows the selection. The animation plays there; this view redraws only when you move it, to spare the graphics card." />
                        <Button Content="Bring it to front" Command="{Binding ShowPopoutCommand}" HorizontalAlignment="Left" Padding="8,2" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <v:CameraBar Viewport="{Binding ElementName=Viewport}" Margin="0,6,0,0" Visibility="{Binding HasModel, Converter={StaticResource BoolVis}}" />

        <v:ModelViewerControls />
    </StackPanel>
</UserControl>
