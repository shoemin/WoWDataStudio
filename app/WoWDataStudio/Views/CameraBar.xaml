<UserControl x:Class="WoWDataStudio.Views.CameraBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:WoWDataStudio.Helpers"
             x:Name="Root">
    <!-- The camera bar of every 3D view (0.5.1): Orbit / Fly, the fixed views, the start view and the help overlay.
         Viewport = the ModelViewport it drives. docs\manual\model-viewer.md#moving-around -->
    <UserControl.Resources>
        <h:EnumEqualsConverter x:Key="EnumEq" />
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
    </UserControl.Resources>
    <WrapPanel>
        <TextBlock Text="Camera" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,10,4"
                    ToolTip="Orbit: turn around the model or tile (the default for models). Fly: move through the scene like in a game, with W A S D, Q / E and the mouse (best for terrain).">
            <RadioButton x:Name="OrbitButton" Style="{StaticResource Segment}" Content="Orbit" GroupName="{Binding GroupName, ElementName=Root}"
                         IsChecked="{Binding Viewport.Navigation, ElementName=Root, Converter={StaticResource EnumEq}, ConverterParameter=Orbit}" />
            <RadioButton x:Name="FlyButton" Style="{StaticResource Segment}" Content="Fly" GroupName="{Binding GroupName, ElementName=Root}"
                         IsChecked="{Binding Viewport.Navigation, ElementName=Root, Converter={StaticResource EnumEq}, ConverterParameter=Fly}" />
        </StackPanel>
        <Button Style="{StaticResource BarButton}" Content="Front" Click="Front_Click" ToolTip="Look at the front of the model (terrain: from the south). Key 1." />
        <Button Style="{StaticResource BarButton}" Content="Side" Click="Side_Click" ToolTip="Look from the side (the model's left; terrain: from the east). Key 2." />
        <Button Style="{StaticResource BarButton}" Content="Top" Click="Top_Click" ToolTip="Look from above (terrain: north up). Key 3." />
        <Button Style="{StaticResource BarButton}" Click="Reset_Click" ToolTip="Back to the start view (Home key, or double-click the view)." Margin="0,0,10,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                <TextBlock Text="Reset view" />
            </StackPanel>
        </Button>
        <ToggleButton Style="{StaticResource Chip}" Margin="0,0,0,4" IsChecked="{Binding Viewport.ShowHelp, ElementName=Root}"
                      ToolTip="Show the keys and mouse controls over the 3D view (H).">
            <TextBlock Text="Controls help (H)" />
        </ToggleButton>
    </WrapPanel>
</UserControl>
