<Window x:Class="WoWDataStudio.Views.ModelExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="model-export-import"
        Style="{StaticResource AppWindow}"
        Title="Export for Blender" Width="720" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Export for Blender" Style="{StaticResource H1}" FontSize="22" />
        <TextBlock x:Name="ModelText" Style="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap" />

        <TextBlock Text="Which skins go into the export?" Style="{StaticResource H3}" FontSize="11" Margin="0,0,0,6" />
        <RadioButton x:Name="ModeCurrent" GroupName="mode" IsChecked="True" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="Current look only" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="620"
                           Text="One file with the skin shown in the app. The simplest choice." />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="ModeVariants" GroupName="mode" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="All skins in one file (switch them in Blender)" FontWeight="SemiBold" />
                <TextBlock x:Name="VariantsText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="620"
                           Text="One file with every skin as a glTF material variant. In Blender, open the sidebar (N) of the 3D view, tab glTF Variants, and click a skin to show it. Paint any of them." />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="ModePerSkin" GroupName="mode" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="One file per skin" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="620"
                           Text="A separate .gltf for each skin (they share the mesh and the skeleton). Useful when another program does not show material variants." />
            </StackPanel>
        </RadioButton>

        <CheckBox x:Name="AnimationsBox" IsChecked="True" Margin="0,4,0,4"
                  Content="Include the animations (every sequence as a Blender action; slower to open for big models)" />
        <CheckBox x:Name="SkeletonBox" IsChecked="False" Margin="0,0,0,2"
                  Content="Skeleton and animations (for editing)" />
        <TextBlock x:Name="SkeletonText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,8" MaxWidth="640"
                   Text="Tick it to add, remove or move bones, edit or create animations, move attachment points and events in Blender. Every animation becomes an action named after the game's animation (Stand, Walk, Attack1H...), events become timeline markers, attachment points and events become empties. The particles and ribbons come as an advanced JSON file. Needs the Blender add-on 0.5 or newer." />
        <CheckBox x:Name="OpenBlenderBox" IsChecked="True" Margin="0,0,0,4" Content="Open in Blender afterwards" />
        <TextBlock x:Name="BlenderText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,10" />

        <TextBlock Text="Save the package in" Style="{StaticResource H3}" FontSize="11" Margin="0,4,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Click="Browse_Click" Margin="8,0,0,0" MinWidth="90" />
            <TextBox x:Name="FolderBox" />
        </DockPanel>
        <TextBlock x:Name="PackageText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

        <Border Background="{StaticResource WarnSoft}" CornerRadius="5" Padding="12,8" Margin="0,12,0,0" x:Name="WarnBox" Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Warn}" FontSize="16" Margin="0,1,10,0" />
                <TextBlock x:Name="WarnText" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="Export" IsDefault="True" MinWidth="140" Style="{StaticResource PrimaryButton}" Click="Export_Click"
                    ToolTip="Write the glTF, the PNG textures and wowdata_manifest.json into the package folder." />
        </StackPanel>
    </StackPanel>
</Window>
