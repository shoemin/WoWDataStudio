<Window x:Class="WoWDataStudio.Views.ServerApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="server-data"
        Style="{StaticResource AppWindow}"
        Title="Apply to server" Width="1000" Height="760" MinWidth="700" MinHeight="460" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Apply to server" Style="{StaticResource H1}" FontSize="20" />
        <TextBlock DockPanel.Dock="Top" x:Name="TargetText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,4" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="What happens: every row the statements below touch is backed up first (and the whole tables, for a manual restore), then the statements run in one transaction, the rows are read back and the apply is written into the applied-changes log. &quot;Undo last apply&quot; puts the rows back from the backup. Only the world database is written; the characters database is never touched." />
        <Border DockPanel.Dock="Top" x:Name="RunningBox" Background="{StaticResource WarnSoft}" CornerRadius="5" Padding="10,6" Margin="0,0,0,6" Visibility="Collapsed">
            <TextBlock x:Name="RunningText" TextWrapping="Wrap" />
        </Border>
        <Border DockPanel.Dock="Top" x:Name="ConflictBox" Background="{StaticResource BadSoft}" CornerRadius="5" Padding="10,6" Margin="0,0,0,6" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Rows that changed on the server since you started editing them:" FontWeight="SemiBold" Foreground="{StaticResource Bad}" />
                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ConflictText" TextWrapping="Wrap" Foreground="{StaticResource Bad}" />
                </ScrollViewer>
                <CheckBox x:Name="OverwriteBox" Content="Overwrite them with my edits" Margin="0,4,0,0" Checked="Overwrite_Changed" Unchecked="Overwrite_Changed" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoft}" CornerRadius="5" Padding="10,6" Margin="0,0,0,6">
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" />
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Content="Back up and apply" Style="{StaticResource PrimaryButton}" MinWidth="170" Click="Apply_Click" />
        </StackPanel>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="The statements" FontWeight="SemiBold" Margin="0,4,0,4" />
            <TextBox x:Name="SqlBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        </DockPanel>
    </DockPanel>
</Window>
