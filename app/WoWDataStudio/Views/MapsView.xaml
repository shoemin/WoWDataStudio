<UserControl x:Class="WoWDataStudio.Views.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WoWDataStudio.Controls"
             xmlns:h="clr-namespace:WoWDataStudio.Helpers"
             xmlns:v="clr-namespace:WoWDataStudio.Views"
             xmlns:s="clr-namespace:WoWDataStudio.Services"
             s:Manual.Topic="maps-and-terrain">
    <!-- The Maps tab (ViewModels\MapsViewModel, docs\manual\maps-and-terrain.md) -->
    <UserControl.Resources>
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <h:BoolToCollapsedConverter x:Key="BoolVisInv" Invert="True" />
        <h:NullToCollapsedConverter x:Key="NullVis" />
        <CollectionViewSource x:Key="MapsByKind" Source="{Binding Maps}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Kind" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="1*" MinWidth="320" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="1.15*" MinWidth="460" />
        </Grid.ColumnDefinitions>

        <!-- maps and zones -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MAPS" Style="{StaticResource H3}" FontSize="11" Margin="12,8,12,4" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="MapList" ItemsSource="{Binding Source={StaticResource MapsByKind}}" SelectedItem="{Binding SelectedMap}" BorderThickness="0,1,0,1" BorderBrush="{StaticResource Border}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ToolTip="The maps of the game (Map.dbc): continents, dungeons, raids and battlegrounds.">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="6,6,0,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"><Run Text="{Binding Directory, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="ZONES" Style="{StaticResource H3}" FontSize="11" Margin="12,8,12,4" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ToolTip="The zones of the map (AreaTable). Click one to light up its tiles on the map.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="2,1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- minimap overview -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,8,12,6">
                    <TextBlock Style="{StaticResource H2}" FontSize="16" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedMap.Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SelectedMap.Kind, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" /></TextBlock>
                    <TextBlock Text="{Binding OverviewStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- 0.13.0: "Pick on the map" of the Quest chains tab -->
                <Border DockPanel.Dock="Top" Background="#FFFFF4D6" BorderBrush="#FFF59E0B" BorderThickness="0,1,0,1" Padding="12,6" Visibility="{Binding IsPicking, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel picking" Command="{Binding CancelPickCommand}" Padding="10,3" />
                        <TextBlock Text="{Binding PickBanner}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" Background="#FFF7F9FC" Padding="12,4" Visibility="{Binding HasPins, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear pins" Command="{Binding ClearPinsCommand}" Padding="8,2" />
                        <TextBlock Text="{Binding PinsText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11" />
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Background="#FFF7F9FC" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,6">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Text="{Binding MinimapHelp, Mode=OneWay}" />
                        <TextBlock Text="{Binding ChangedSummary}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Border>
                <c:MinimapView x:Name="Minimap" Source="{Binding Overview}" Cell="{Binding OverviewCell}" OriginX="{Binding OriginX}" OriginY="{Binding OriginY}" Tiles="{Binding Tiles}"
                               Selected="{Binding SelectedTile}" Highlight="{Binding ZoneTiles}" Changed="{Binding ChangedTiles}" Pending="{Binding PendingTiles}" Pins="{Binding Pins}" />
            </DockPanel>
        </Border>

        <!-- tile: 3D preview, details, actions -->
        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="{Binding HasTile, Converter={StaticResource BoolVisInv}}">
                    <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#FFB0B8C4" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a tile on the map" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" Text="{Binding EmptyTileText, Mode=OneWay}" />
                </StackPanel>
                <ScrollViewer x:Name="TileScroll" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTile, Converter={StaticResource BoolVis}}">
                    <StackPanel Margin="14,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#FFFFE7CC" Visibility="{Binding IsTileModified, Converter={StaticResource BoolVis}}"
                                    ToolTip="Your workspace has an edited version of this tile; the views show it.">
                                <TextBlock Text="Modified" Foreground="{StaticResource Modified}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding TileTitle}" Style="{StaticResource H2}" FontSize="18" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding TileSubtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        <WrapPanel Margin="0,6,0,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}">
                            <Button x:Name="BreakDownButton" Command="{Binding BreakDownTileCommand}" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource PrimaryButton}"
                                    ToolTip="Opens a window that lists every piece of this tile by kind (the ground and its 256 chunks, ground textures, trees and objects, buildings, water, sounds), shows each one in 3D or on its own, and opens it in the Browse tab or in Blender.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                                    <TextBlock Text="Break down this tile..." />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- 3D terrain preview -->
                        <Border x:Name="PreviewBox" Margin="0,8,0,0" CornerRadius="6" Background="#FF2B3038" Height="380" ClipToBounds="True">
                            <Grid>
                                <c:ModelViewport x:Name="TerrainView" Terrain="{Binding Scene}" Camera="{Binding Camera}" Navigation="{Binding Navigation}" ShowHelp="{Binding ShowHelp}"
                                                 ToolTip="3D view of the tile. Orbit: left-drag turns, right-drag moves, wheel zooms. Fly: W A S D and the mouse. H: all the controls. Double-click: back to the start view." />
                                <Border Background="#C0101418" CornerRadius="4" Padding="8,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                        Visibility="{Binding PreviewLoading, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding PreviewStatus}" Foreground="White" />
                                </Border>
                                <Button x:Name="PopOutButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,3" Command="{Binding PopOutCommand}"
                                        Style="{StaticResource BaseButton}" Opacity="0.92"
                                        ToolTip="Open the 3D view of the tile in a window of its own, to make it bigger, put it on another monitor or fly through it full screen (Ctrl+Shift+O).">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" />
                                        <TextBlock Text="Open in new window" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <v:CameraBar Viewport="{Binding ElementName=TerrainView}" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,2,0,0">
                            <CheckBox Content="Neighbour tiles" IsChecked="{Binding IncludeNeighbours}" Margin="0,0,12,4" ToolTip="Also show the 8 tiles around this one (slower)." />
                            <CheckBox Content="Doodads" IsChecked="{Binding ShowDoodads}" Margin="0,0,12,4" ToolTip="Trees, rocks, fences... (M2 models, shown without animation)." />
                            <CheckBox Content="Buildings" IsChecked="{Binding ShowWmos}" Margin="0,0,12,4" ToolTip="WMO buildings (simple rendering)." />
                            <CheckBox Content="Water" IsChecked="{Binding ShowWater}" Margin="0,0,12,4" />
                            <CheckBox Content="Textures" IsChecked="{Binding ShowTextures}" Margin="0,0,12,4" ToolTip="Untick to see the shape of the ground only." />
                            <CheckBox Content="Wireframe" IsChecked="{Binding Wireframe}" Margin="0,0,12,4" />
                            <CheckBox IsChecked="{Binding SpecularGround}" Margin="0,0,12,4" Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}"
                                      ToolTip="With terrain specular on (Config.wtf: specular 1 and pixelShaders 1) the game draws &lt;name&gt;_s.blp instead of the ground texture the map names. Ticked: the 3D view does the same. It starts as your game's setting.">
                                <TextBlock Text="Specular ground (_s textures)" />
                            </CheckBox>
                        </WrapPanel>
                        <TextBlock Text="{Binding GroundRuleText}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding PreviewStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />

                        <!-- facts -->
                        <ItemsControl ItemsSource="{Binding TileFacts}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <TextBlock DockPanel.Dock="Left" Text="&#x2022;" Margin="2,0,8,0" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- actions -->
                        <Border x:Name="MapActions" Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="#FFF7F9FC" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="EDIT THE MAP" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <Button Content="Edit in Noggit..." Command="{Binding EditInNoggitCommand}" Margin="0,0,6,6" Padding="10,4" Style="{StaticResource PrimaryButton}"
                                            ToolTip="Prepares a Noggit project for this map (reading a safe view of the game, never writing into it) with a bookmark at this tile, and explains the steps. Noggit is a separate program." />
                                    <Button Content="Import map changes..." Command="{Binding ImportMapChangesCommand}" Margin="0,0,6,6" Padding="10,4"
                                            ToolTip="Finds the files Noggit saved for this map, checks each with the 1.12 rules, and shows what changed (with a 3D before/after) before anything is saved." />
                                    <Button Content="Open terrain in Blender..." Command="{Binding OpenTerrainInBlenderCommand}" Margin="0,0,6,6" Padding="10,4"
                                            ToolTip="Pick this tile and its neighbours, and edit their ground heights in Blender (each tile its own object, edges you can sync)." />
                                    <Button x:Name="ImportTerrainButton" Content="Import edited terrain..." Command="{Binding ImportEditedTerrainCommand}" Margin="0,0,6,6" Padding="10,4"
                                            ToolTip="Brings the heights you edited in Blender back: checks the shared edges with the neighbouring tiles, recomputes the lighting normals, validates, and shows the review with a 3D before/after." />
                                    <Button Content="Compare original vs. edited" Command="{Binding CompareTileCommand}" IsEnabled="{Binding IsTileModified}" Margin="0,0,6,6" Padding="10,4"
                                            ToolTip="Two synchronized 3D views of the game's tile and your edited one, the height difference and the list of changes." />
                                    <Button Content="Revert the tile" Command="{Binding RevertTileCommand}" IsEnabled="{Binding IsTileModified}" Margin="0,0,6,6" Padding="10,4"
                                            ToolTip="Deletes your edited tile: the game's tile is used again." />
                                    <Button Content="Open the Noggit project folder" Command="{Binding OpenNoggitFolderCommand}" Margin="0,0,6,6" Padding="10,4" />
                                </WrapPanel>
                                <TextBlock Text="PUT IT INTO THE GAME AND THE SERVER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,6,0,6" />
                                <WrapPanel>
                                    <Button Content="Test map in game (loose files)" Command="{Binding TestMapInGameCommand}" IsEnabled="{Binding HasMapChanges}" Margin="0,0,6,6" Padding="10,4"
                                            ToolTip="Copies this map's changed files into the game's Data folder as loose files (needs the client's loose-file mode)." />
                                    <Button Content="Build release patch (patch-3.MPQ)..." Command="{Binding BuildPatchCommand}" IsEnabled="{Binding HasMapChanges}" Margin="0,0,6,6" Padding="10,4"
                                            ToolTip="Packs ALL your changes (textures, models and maps) into patch-3.MPQ." />
                                    <Button Content="Update server maps..." Command="{Binding UpdateServerCommand}" Margin="0,0,6,6" Padding="10,4"
                                            ToolTip="Guided: re-extract the server's terrain, collision and pathing from your patched game into a staging folder, then install them into the server (with a backup and an undo)." />
                                </WrapPanel>
                                <Border Background="{StaticResource WarnSoft}" CornerRadius="4" Padding="8,5" Margin="0,2,0,0">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="12"
                                               Text="A map change needs the server updated too: the world server has its own copy of the terrain, collision and pathing. Without it creatures walk on the old ground and pathing does not match. Use &quot;Update server maps...&quot; after testing." />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- what is placed on the tile -->
                        <Expander x:Name="TileUsageBox" Margin="0,10,0,0" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock><Run Text="On this tile" FontWeight="SemiBold" /><Run Text="{Binding TileUsage.ShortText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" /></TextBlock>
                            </Expander.Header>
                            <v:UsedInGameView DataContext="{Binding TileUsage}" Margin="4,4,0,0" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
