<Window x:Class="WoWDataStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WoWDataStudio.Views"
        xmlns:h="clr-namespace:WoWDataStudio.Helpers"
        xmlns:s="clr-namespace:WoWDataStudio.Services"
        s:Manual.Topic="getting-started"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle}" Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <!-- 0.5.1: the 3D view of the selected model or map tile in a new window -->
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding Browser.PopOutCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <h:EnumToVisibilityConverter x:Key="EnumVis" />
        <h:BoolToCollapsedConverter x:Key="BoolVis" />
        <h:NullToCollapsedConverter x:Key="NullVis" />
    </Window.Resources>
    <Grid>
        <!-- ============================== WELCOME ============================== -->
        <Grid x:Name="WelcomeScreen" Visibility="{Binding Screen, Converter={StaticResource EnumVis}, ConverterParameter=Welcome}">
            <Border Style="{StaticResource Card}" Width="720" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36">
                <StackPanel>
                    <TextBlock Text="Welcome to WoW Data Studio" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,22"
                               Text="Find any creature, item, character, object or texture of World of Warcraft 1.12, look at it, export it, edit it in your favourite image editor and put your changes back into the game." />
                    <TextBlock Text="Select your World of Warcraft folder" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                               Text="This is the folder that contains WoW.exe and the Data folder (version 1.12.1, build 5875). The game files are only read; nothing in the game folder is changed unless you click an install button later." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" MinWidth="100"
                                ToolTip="Pick the World of Warcraft folder." />
                        <TextBox Text="{Binding FolderText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" />
                    </DockPanel>
                    <Border Background="{StaticResource BadSoft}" CornerRadius="5" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding WelcomeError, Converter={StaticResource NullVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Bad}" FontSize="16" Margin="0,1,10,0" />
                            <TextBlock Text="{Binding WelcomeError}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <Border Background="{StaticResource GoodSoft}" CornerRadius="5" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding WelcomeHint, Converter={StaticResource NullVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Good}" FontSize="16" Margin="0,1,10,0" />
                            <TextBlock Text="{Binding WelcomeHint}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <Button Content="Load game data" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="22,9" Margin="0,22,0,0"
                            HorizontalAlignment="Left" Command="{Binding UseFolderCommand}" IsDefault="True"
                            ToolTip="Check the folder and organize its data (a few seconds the first time)." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================== ORGANIZING ============================== -->
        <Grid x:Name="OrganizingScreen" Visibility="{Binding Screen, Converter={StaticResource EnumVis}, ConverterParameter=Organizing}">
            <Border Style="{StaticResource Card}" Width="720" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36">
                <StackPanel>
                    <TextBlock Text="{Binding OrganizingTitle}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding OrganizingSubtitle}" Style="{StaticResource Muted}" Margin="0,8,0,18" />
                    <ProgressBar Height="14" Value="{Binding ProgressPercent}" Maximum="100" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding ProgressDetail}" Margin="0,8,0,16" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{Binding Stages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFB0B8C4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="Foreground" Value="{StaticResource Good}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="Foreground" Value="{StaticResource TextMain}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================== MAIN ============================== -->
        <v:BrowserView x:Name="BrowserScreen" DataContext="{Binding Browser}"
                       Visibility="{Binding DataContext.Screen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumVis}, ConverterParameter=Browser}" />

        <!-- toast -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="28,0,0,28" Background="#F01B2430" CornerRadius="6" Padding="16,10"
                MaxWidth="760" Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Command="{Binding HideToastCommand}" Margin="14,0,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="White" Padding="4" ToolTip="Hide" />
                <TextBlock Text="{Binding ToastText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- busy overlay -->
        <Grid Background="#80F4F6F9" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ProgressBar IsIndeterminate="True" Height="6" Width="280" Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
